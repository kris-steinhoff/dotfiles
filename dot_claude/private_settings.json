{
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "aws-core@agent-toolkit-for-aws": true
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "repo": "addyosmani/agent-skills",
        "source": "github"
      }
    },
    "agent-toolkit-for-aws": {
      "source": {
        "repo": "aws/agent-toolkit-for-aws",
        "source": "github"
      }
    }
  },
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/sort-settings-json.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "user_settings"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  },
  "model": "claude-opus-4-8",
  "modelSettings": {
    "claude-opus-4-8": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "additionalDirectories": [
      "~/scratch"
    ],
    "defaultMode": "auto"
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "filesystem": {
      "allowRead": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "denyRead": [
        "~/.ssh/agent",
        "~/.aws/credentials",
        "~/.aws/sso",
        "~/.aws/cli",
        "~/.aws/login",
        "~/.config/op",
        "~/Library/Application Support/glab-cli",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowUnixSockets": [
        "~/.config/herdr/herdr.sock",
        "~/.config/herdr/herdr-client.sock",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowedDomains": [
        "127.0.0.1",
        "localhost"
      ]
    }
  },
  "statusLine": {
    "command": "npx -y @owloops/claude-powerline@latest",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh"
  }
}
