#!/usr/bin/env python3
"""Serve the plan page with a fixture's data, against a stand-in for the artifact runtime.

    view [fixture or path.json] [--page path.html] [--port N] [--no-open]

/ lists the fixtures, and /?fixture=<name> renders one. With a fixture's name or path, opens that plan page;
with neither, opens the list. --page serves another copy of the page, to compare with or to break on purpose.
Runs until Ctrl-C.
assets/plan-page.html is served as it is, with the stand-in and the fixture's data placed ahead of it.
"""
from __future__ import annotations

import argparse
import errno
import html
import json
import sys
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import parse_qs, quote, urlparse

HERE = Path(__file__).resolve().parent
PAGE = HERE.parent / "assets" / "plan-page.html"
# The skeleton the Artifact tool wraps every page in. Its [hidden] rule matters: the page relies on it,
# because its own flex and grid rules would otherwise show hidden elements such as the progress bar.
WRAPPER_OPEN = (
    '<!doctype html><html><head><meta charset=utf8>'
    '<meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>'
    ":root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);"
    "padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}"
    "body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}"
    "img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>"
)
STAND_IN = HERE / "stand-in.js"
MEASURE = HERE / "measure.js"
DEFAULT_PORT = 8737
SHAPES = ["small", "big", "simple", "complex"]
STAGES = ["planning", "running", "done"]


# A fixture named by its path rather than kept in this folder, such as a captured live plan.
extra_fixtures: dict[str, Path] = {}


def fixture_paths() -> dict[str, Path]:
    return {**{path.stem: path for path in HERE.glob("*.json")}, **extra_fixtures}


def fixture_names() -> list[str]:
    return sorted(fixture_paths())


def page_for(name: str) -> str:
    fixture = json.loads(fixture_paths()[name].read_text(encoding="utf-8"))
    title = fixture["docs"]["run/main"].get("title", name) + " - Implementation Plan"
    page = PAGE.read_text(encoding="utf-8").replace("__PLAN_TITLE__", html.escape(title))
    # "</" would otherwise let a string in the data close the script element.
    data = json.dumps(fixture).replace("</", "<\\/")
    return (
        f'{WRAPPER_OPEN}\n<script>window.__FIXTURE__ = {data};</script>\n<script src="/stand-in.js"></script>\n'
        f"{page}\n</body></html>\n"
    )


def fixture_url(name: str) -> str:
    return f"/?fixture={quote(name)}"


def index_page() -> str:
    names = set(fixture_names())
    head = "".join(f"<th>{stage}</th>" for stage in STAGES)
    rows = []
    for shape in SHAPES:
        cells = []
        for stage in STAGES:
            name = f"{shape}-{stage}"
            cells.append(f'<td><a href="{fixture_url(name)}">{name}</a></td>' if name in names else "<td>&mdash;</td>")
        rows.append(f"<tr><th>{shape}</th>{''.join(cells)}</tr>")
    shaped = {f"{shape}-{stage}" for shape in SHAPES for stage in STAGES}
    others = "".join(
        f'<li><a href="{fixture_url(name)}">{html.escape(name)}</a></li>' for name in sorted(names - shaped)
    )
    return (
        '<!doctype html>\n<meta charset="utf-8">\n<title>Plan page fixtures</title>\n'
        "<style>body{font:15px/1.5 system-ui,sans-serif;margin:32px}td,th{padding:6px 16px;text-align:left}</style>\n"
        f"<h1>Plan page fixtures</h1>\n<table><tr><td></td>{head}</tr>" + "".join(rows) + "</table>\n"
        + (f"<ul>{others}</ul>\n" if others else "")
        + "<p>Add <code>&amp;role=viewer</code> or <code>&amp;role=editor</code> to a fixture's URL to see it as someone "
        "else, <code>&amp;theme=dark</code> for the dark theme, and <code>&amp;session=none</code> to answer with no "
        "Claude session watching.</p>\n"
    )


class Handler(BaseHTTPRequestHandler):
    def do_GET(self) -> None:
        url = urlparse(self.path)
        fixture = parse_qs(url.query).get("fixture", [None])[0]
        if url.path == "/stand-in.js":
            self.reply(200, "text/javascript; charset=utf-8", STAND_IN.read_text(encoding="utf-8"))
        elif url.path == "/measure.js":
            self.reply(200, "text/javascript; charset=utf-8", MEASURE.read_text(encoding="utf-8"))
        elif url.path == "/favicon.ico":
            self.reply(204, "image/x-icon", "")
        elif url.path != "/":
            self.reply(404, "text/plain; charset=utf-8", "Not found.\n")
        elif fixture is None:
            self.reply(200, "text/html; charset=utf-8", index_page())
        elif fixture in fixture_names():
            self.reply(200, "text/html; charset=utf-8", page_for(fixture))
        else:
            self.reply(404, "text/plain; charset=utf-8", "No such fixture.\n")

    def reply(self, status: int, content_type: str, body: str) -> None:
        data = body.encode("utf-8")
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, format: str, *args: object) -> None:
        pass


def serve(port: int) -> ThreadingHTTPServer:
    try:
        return ThreadingHTTPServer(("127.0.0.1", port), Handler)
    except OSError as error:
        if error.errno != errno.EADDRINUSE:
            raise
        return ThreadingHTTPServer(("127.0.0.1", 0), Handler)


def main() -> int:
    parser = argparse.ArgumentParser(description="View the plan page with a fixture's data.")
    parser.add_argument("fixture", nargs="?", help="a fixture's name, such as big-running, or a path to one; omit for the list")
    parser.add_argument("--page", help="serve this copy of the page instead of assets/plan-page.html")
    parser.add_argument("--port", type=int, default=DEFAULT_PORT, help=f"port to try first (default {DEFAULT_PORT})")
    parser.add_argument("--no-open", action="store_true", help="print the URL without opening a browser")
    args = parser.parse_args()
    if args.page:
        global PAGE
        PAGE = Path(args.page).resolve()
        if not PAGE.is_file():
            print(f"No page at {PAGE}", file=sys.stderr)
            return 2
    if args.fixture and args.fixture.endswith(".json"):
        path = Path(args.fixture).resolve()
        extra_fixtures[path.stem] = path
        args.fixture = path.stem
    if args.fixture and args.fixture not in fixture_names():
        print(f"No fixture named {args.fixture}. There are: {', '.join(fixture_names())}", file=sys.stderr)
        return 2
    server = serve(args.port)
    target = fixture_url(args.fixture) if args.fixture else "/"
    url = f"http://127.0.0.1:{server.server_address[1]}{target}"
    print(f"Serving {url} (Ctrl-C to stop)", flush=True)
    if not args.no_open:
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    return 0


if __name__ == "__main__":
    sys.exit(main())
