#!/usr/bin/env zsh

# === Environment ===
export PATH="${PATH}:${HOME}/.local/bin"
if command -v nvim &>/dev/null; then
  export EDITOR="${OVERRIDE_EDITOR:-nvim}"
else
  export EDITOR="${OVERRIDE_EDITOR:-vim}"
fi
export PIP_DISABLE_PIP_VERSION_CHECK=1

# pre-commit draws its status chips as ANSI background colors, and GREEN
# ('\033[42m') sets no foreground, so "Passed" renders in the terminal's
# default fg. Against tokyonight's pastel green that's unreadable. Plain
# text beats a low-contrast block.
export PRE_COMMIT_COLOR=never

# === Homebrew ===

if [[ -f /opt/homebrew/bin/brew ]]; then
	eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /home/linuxbrew/.linuxbrew/bin/brew ]]; then
	eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
fi

export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_ANALYTICS=1

# === Zsh Configuration ===

# Use emacs keybindings (^A, ^E, etc.) regardless of $EDITOR
# Escape enters vi command mode for modal editing
bindkey -e
bindkey '\e' vi-cmd-mode

# Completions from brew packages
if type brew &>/dev/null; then
	if [[ -d "$(brew --prefix)/share/zsh-completions" ]]; then
		fpath=("$(brew --prefix)/share/zsh-completions" $fpath)
	fi
	fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi

fpath+=~/.zfunc

autoload -Uz compinit
compinit

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors ${(s.:.)LS_COLORS}

# direnv for per-project environment variables
if type direnv &>/dev/null; then
	eval "$(direnv hook zsh)"
fi

# Edit command in $EDITOR with Ctrl+X Ctrl+E
autoload -U edit-command-line
zle -N edit-command-line
bindkey '^X^E' edit-command-line

# === Zsh Plugins ===
# Load zsh-autosuggestions and zsh-syntax-highlighting from wherever they were
# installed — Homebrew, Debian/Ubuntu apt (/usr/share), Arch (/usr/share/zsh/
# plugins), or a manual /usr/local prefix. Every layout uses the same
# <dir>/<name>/<name>.zsh shape, so we just try each base dir in turn.
# autosuggestions is sourced before syntax-highlighting, as the latter requires,
# and this block sits after the key bindings above (syntax-highlighting must
# load last among things that hook zle).
_zsh_plugin_dirs=(/usr/share /usr/local/share /usr/share/zsh/plugins)
if type brew &>/dev/null; then
	_zsh_plugin_dirs=("$(brew --prefix)/share" $_zsh_plugin_dirs)
fi
for _plugin in zsh-autosuggestions zsh-syntax-highlighting; do
	for _dir in $_zsh_plugin_dirs; do
		if [[ -r "$_dir/$_plugin/$_plugin.zsh" ]]; then
			source "$_dir/$_plugin/$_plugin.zsh"
			break
		fi
	done
done
unset _plugin _dir _zsh_plugin_dirs

# === Starship Prompt ===
if type starship &>/dev/null; then
	eval "$(starship init zsh)"
fi

# === Options ===
unsetopt share_history
setopt hist_ignore_dups
setopt hist_ignore_space
setopt auto_cd
setopt auto_pushd
setopt interactive_comments

# === History ===
HISTSIZE=10000
SAVEHIST=10000
HISTFILE=~/.zsh_history

# === Functions ===

# Inspect a path: `s <dir>` gives the eza listing, `s <file>` a
# syntax-highlighted view via bat. No arg inspects the current directory.
# Both tools are in the Brewfile; fall back to ls/cat if they're missing.
s() {
	emulate -L zsh
	local target="${1:-.}"
	if [[ -d $target ]]; then
		if command -v eza &>/dev/null; then
			eza -lah --git "$target"
		else
			ls -lah --color=auto "$target"
		fi
	elif [[ -e $target ]]; then
		if command -v bat &>/dev/null; then
			bat --style=changes,snip --wrap=never --pager='less -RF' "$target"
		elif command -v batcat &>/dev/null; then
			batcat --style=changes,snip --wrap=never --pager='less -RF' "$target"
		else
			cat "$target"
		fi
	else
		print -u2 "s: no such path: $target"
		return 1
	fi
}

activate() {
	if [ -d ".venv" ]; then
		source ".venv/bin/activate"
	elif [ -d "venv" ]; then
		source "venv/bin/activate"
	else
		echo "No virtualenv found (.venv or venv)"
	fi
}

_aws_profile_is_sso() {
	local profile="${1:-${AWS_PROFILE:-default}}"
	aws configure get sso_start_url --profile "$profile" &>/dev/null \
		|| aws configure get sso_session --profile "$profile" &>/dev/null
}

aws-profile-login() {
	export AWS_PROFILE="$1"
	if ! aws sts get-caller-identity &>/dev/null; then
		if _aws_profile_is_sso "$AWS_PROFILE"; then
			local sso_args=()
			[[ -n "${SSH_CONNECTION:-}" ]] && sso_args+=(--use-device-code)
			aws sso login "${sso_args[@]}"
		else
			aws login
		fi
	fi
}

aws-profile-logout() {
	if _aws_profile_is_sso "$AWS_PROFILE"; then
		aws sso logout
	else
		aws logout
		unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
	fi
	unset AWS_PROFILE
}

# === Aliases ===

# General
if command -v eza &>/dev/null; then
	alias l='eza -lah --git'
	alias ll='eza -lh --git'
else
	alias l='ls -lah --color=auto'
	alias ll='ls -lh --color=auto'
fi

# Pre-commit

alias pcra="pre-commit run --all-files"

# Markdown
# Soft-wrap prose: one line per paragraph, wrap width left to the editor.
# Version-pinned to match the prettier hook in .pre-commit-config.yaml.
# printWidth is deliberately not passed, since prettier also formats code
# inside fenced blocks and a width forced here would reflow that too.
alias mdfmt='npx --yes prettier@3.3.3 --prose-wrap never --write'

# Docker
alias dc='docker compose'
alias dco='docker compose'

# Git
alias g='git'

# Git - status & info
alias gst='git status'
alias gsh='git show'
alias gd='git diff'
alias gds='git diff --staged'
alias glg='git --no-pager l -20'

# Git - staging & commits
alias ga='git add'
alias grs='git restore'
alias gc='git commit --verbose'
alias gca='git commit --verbose --all'

# Git - branches
alias gb='git branch'
alias gba='git branch --all'
alias gbm='git branch --move'
alias gbd='git branch --delete'
alias gbD='git branch --delete --force'
alias gco='git checkout'
alias gsw='git switch'
alias gswc='git switch --create'
alias gswm='git switch main'
alias gm='git merge'

# Git - remote
alias gf='git fetch'
alias gl='git pull'
alias gp='git push'
alias gpf='git push --force-with-lease'
alias gpsup='git push --set-upstream origin $(git branch --show-current)'
alias gcl='git clone'

# Git - rebase & stash
alias grb='git rebase'
alias grbi='git rebase --interactive'
alias grbom='git rebase --interactive --onto main'
alias grbc='git rebase --continue'
alias grba='git rebase --abort'
alias gsta='git stash'
alias gstp='git stash pop'

# Git - worktree
# wt (~/.local/bin/wt) creates, lists, and removes worktrees under the main
# checkout's .worktrees/. These wrappers exist only to change directory.
alias wtl='wt list'

# Create a worktree with wt add and cd into it. wt prints only the path on
# stdout; its messages and setup output reach the terminal on stderr.
wta() {
	emulate -L zsh
	local dir
	dir=$(command wt add "$@") || return
	cd "$dir"
}

# Remove a worktree with wt remove, then cd to the main checkout if the
# current directory went with it. Returns wt's exit status.
wtr() {
	emulate -L zsh
	local main rc
	main=$(command wt list --json 2>/dev/null | jq -r 'select(.main) | .path')
	command wt remove "$@"
	rc=$?
	if [[ ! -d $PWD && -n $main ]]; then
		cd "$main"
	fi
	return rc
}

# Complete wtr with the names of the worktrees under .worktrees/.
_wt_worktrees() {
	local -a names
	names=(${(f)"$(command wt list --json 2>/dev/null | jq -r 'select(.main | not) | .name')"})
	compadd -- $names
}
compdef _wt_worktrees wtr

# Complete wta with local + remote-tracking branches, remote prefix stripped
# (origin/foo -> foo), deduped. New branch names are just typed in.
_wt_branches() {
	local -a locals remotes
	locals=(${(f)"$(git for-each-ref --format='%(refname:short)' refs/heads 2>/dev/null)"})
	remotes=(${(f)"$(git for-each-ref --format='%(refname)' refs/remotes 2>/dev/null)"})
	remotes=(${remotes:#*/HEAD})
	compadd -- ${(u)locals} ${(u)remotes#refs/remotes/*/}
}
compdef _wt_branches wta

# tmux
alias t='tmux'
alias tl='tmux list-sessions'
alias tk='tmux kill-session -t'     # kill a named session: tk <name>
alias tks='tmux kill-server'        # kill the server and ALL sessions

# New session named $1, or after the current directory if no name is given.
# tmux rejects '.' and ':' in session names, so substitute them with '_'.
tn() {
	local name="${1:-${PWD:t}}"
	tmux new-session -s "${name//[.:]/_}"
}

# Attach to session $1, or to one named after the current directory.
ta() {
	local name="${1:-${PWD:t}}"
	tmux attach -t "${name//[.:]/_}"
}

# Complete `ta` with the names of running tmux sessions.
_ta() {
	local -a sessions
	sessions=(${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"})
	compadd -- $sessions
}
compdef _ta ta
