theme = tokyonight

# Disable ligatures
font-feature = -calt
font-feature = -liga
font-feature = -dlig

# Always open new windows in $HOME instead of inheriting the parent's CWD
working-directory = home
window-inherit-working-directory = false

# Override Ghostty's default "performable:copy_to_clipboard" on Cmd-C, which
# passes the key through when there's no selection (leaking a stray "c" while
# herdr owns the selection). This always consumes Cmd-C instead.
keybind = super+c=copy_to_clipboard

# Drop Ghostty's default Cmd-Enter fullscreen binding, which collides with the
# muscle memory for "submit" in GitHub, Jira, etc. Ctrl-Cmd-F, the macOS
# system-standard full screen shortcut, still works.
#
# Bind to a plain carriage return instead of `unbind`: unbind lets Ghostty's
# extended keyboard protocol send the raw Cmd-Enter through as a CSI u
# sequence (ESC [ 13 ; 9 u), and zsh's `bindkey '\e' vi-cmd-mode` reacts to
# that leading ESC before the rest of the sequence arrives, dropping the
# prompt into vi command mode instead of submitting.
keybind = super+enter=text:\r

# Default clipboard-read is "ask", which shows a permission prompt on every
# OSC 52 paste. Neovim's built-in OSC 52 paste provider (used inside Herdr,
# see nvim's init.lua) doesn't reliably detect that prompt's response and
# hangs on "Waiting for OSC 52 response" until interrupted. Allowing reads
# outright removes the prompt and the hang.
clipboard-read = allow
