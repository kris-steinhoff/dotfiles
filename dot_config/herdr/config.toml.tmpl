onboarding = false

[ui]
show_agent_labels_on_pane_borders = true
prompt_new_tab_name = false
hide_tab_bar_when_single_tab = true

agent_panel_sort = "priority"

[ui.sidebar.spaces]
row_gap = 1

[ui.sound]
enabled = true

[ui.toast]
delivery = "terminal"

[ui.toast.clipboard]
enabled = false

[theme]
name = "tokyo-night"
auto_switch = false

[keys]
prefix = "ctrl+space"

# Repurpose prefix+p / prefix+n for agent navigation (they default to tab nav).
previous_agent = "prefix+p"
next_agent = "prefix+n"
# Free up the keys above by unsetting the default tab navigation bindings.
previous_tab = ""
next_tab = ""

# prefix+u toggles a "⚑ " attention flag on the focused agent's name. herdr has
# no way to re-raise the sidebar attention dot once you've viewed a done agent,
# so this gives a persistent, manual "come back to this" marker instead.
# Absolute path (templated) so it resolves whether herdr runs the command
# through a shell or execs it directly.
[[keys.command]]
key = "prefix+u"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/toggle-agent-flag.sh"
