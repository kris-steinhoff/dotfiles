onboarding = false

[ui]
show_agent_labels_on_pane_borders = true
prompt_new_tab_name = false
hide_tab_bar_when_single_tab = true

agent_panel_sort = "priority"

[ui.sidebar.spaces]
row_gap = 1
# $signal is a workspace metadata token an agent sets with the signal-user
# skill to say why it stopped ("✋ pick a migration strategy", "✓ PR #254",
# "… CI"). It gets its own line because a reason inline with the name
# truncates and buries the name, and keeps the token's default color so it
# suits any signal; the glyph carries the meaning. Only ✋ is an emoji, which
# renders in full color whatever the token color, so it stands out; ✓ and … are
# text glyphs and draw dim, so the signals that don't need the user recede.
# $flag is the manual "⚑" that prefix+u toggles, kept on the same line but in
# its own token so neither replaces the other. The row disappears when both
# are unset.
rows = [
  ["state_icon", "workspace"],
  ["$flag", "$signal"],
  ["branch", "git_status"],
]

[ui.sound]
enabled = true

[ui.toast]
delivery = "terminal"

[ui.toast.clipboard]
enabled = false

[theme]
name = "tokyo-night"
auto_switch = false

[keys]
prefix = "ctrl+space"

# Repurpose prefix+p / prefix+n for agent navigation (they default to tab nav).
previous_agent = "prefix+p"
next_agent = "prefix+n"
# Free up the keys above by unsetting the default tab navigation bindings.
previous_tab = ""
next_tab = ""

# prefix+u toggles a "⚑" flag on the focused workspace. herdr has no way to
# re-raise the sidebar attention dot once you've viewed a done agent, so this
# gives a persistent, manual "come back to this" marker instead. prefix+U
# dismisses an agent's ✋ or ✓, for one dealt with without replying to the
# agent (a PR approved on GitHub); it leaves a `…` alone. Separate keys, because
# one key that did both cleared signals when you meant to flag.
# Absolute paths (templated) so they resolve whether herdr runs the command
# through a shell or execs it directly.
[[keys.command]]
key = "prefix+u"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/toggle-flag.sh"
description = "toggle ⚑ flag"

[[keys.command]]
key = "prefix+shift+u"
type = "shell"
command = "{{ .chezmoi.homeDir }}/.config/herdr/dismiss-signal.sh"
description = "dismiss ✋/✓"
