onboarding = false

[ui]
show_agent_labels_on_pane_borders = true
prompt_new_tab_name = false
hide_tab_bar_when_single_tab = true

agent_panel_sort = "priority"

[ui.sidebar.spaces]
row_gap = 1
rows = [
  ["state_icon", "workspace"],
  ["branch", "git_status"],
]

# Off: with many agents in flight, the finished and needs-input chimes were
# constant. Popups and the sidebar still show agent state.
[ui.sound]
enabled = false

[ui.toast]
delivery = "herdr"

[ui.toast.clipboard]
enabled = false

[theme]
name = "tokyo-night"
auto_switch = false

[keys]
prefix = "ctrl+space"

# Repurpose prefix+p / prefix+n for agent navigation (they default to tab nav).
previous_agent = "prefix+p"
next_agent = "prefix+n"
# Free up the keys above by unsetting the default tab navigation bindings.
previous_tab = ""
next_tab = ""
