#!/usr/bin/env python3
"""Behavior tests for github-review-queue, against a fake gh and real git
repos."""

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest


SCRIPT = Path(__file__).resolve().parents[1] / "dot_local" / "bin" / "executable_github-review-queue"

ITEM_KEYS = {"number", "title", "url", "author", "base_branch", "head_branch", "head_sha",
             "created_at", "size", "stacked_on", "jira_keys", "state", "other_reviewers"}


# A fake gh. The queue is a JSON file of PRs; each one's head is origin's
# refs/pull/<n>/head, as GitHub reports it. A PR's "reviews" lists
# [login, commit, state, body], the commit being a PR number (that PR's head
# now), a literal sha, or null; state defaults to COMMENTED and body to text.
# A login ending in [bot] is a bot. The PR's author is always ada.
# FAKE_OPEN holds open PRs that are not in the queue, as JSON.
FAKE_GH = r'''#!/usr/bin/env python3
import json
import os
import subprocess
import sys

args = sys.argv[1:]
queue = json.load(open(os.environ["FAKE_QUEUE"]))
others = json.loads(os.environ.get("FAKE_OPEN") or "[]")


def head(n):
    return subprocess.run(["git", "-C", os.environ["FAKE_ORIGIN"], "rev-parse", f"refs/pull/{n}/head"],
                          capture_output=True, text=True).stdout.strip()


def review(login, commit, state="COMMENTED", body="Looks good."):
    oid = head(commit) if isinstance(commit, int) else commit
    kind = "Bot" if login.endswith("[bot]") else "User"
    return {"author": {"login": login, "__typename": kind}, "state": state, "body": body,
            "commit": {"oid": oid} if oid else None}


def field(name):
    """A -f or -F field's value from the gh api call."""
    for flag, value in zip(args, args[1:]):
        if flag in ("-f", "-F") and value.startswith(name + "="):
            return value[len(name) + 1:]


def record(pr):
    return {"number": pr["number"], "title": pr.get("title", f"PR {pr['number']}"), "url": "u",
            "author": {"login": "ada"}, "baseRefName": pr.get("base", "main"),
            "headRefName": pr.get("head", f"pr-{pr['number']}"), "headRefOid": head(pr["number"]),
            "additions": 1, "deletions": 1, "changedFiles": pr.get("changed_files", 1),
            "isCrossRepository": pr.get("cross_repository", False), "createdAt": "2026-01-01T00:00:00Z"}


if args[:2] == ["api", "user"]:
    print("kris")
elif args[:2] == ["api", "graphql"]:
    assert (field("owner"), field("name")) == ("{owner}", "{repo}"), args
    pr = next(pr for pr in queue + others if pr["number"] == int(field("pr")))
    everyone = [review(*r) for r in pr.get("reviews", [])]
    mine = [{k: v for k, v in r.items() if k != "author"}
            for r in everyone if r["author"]["login"] == field("author")]
    latest = {}  # each person's latest approval or change request
    for r in everyone:
        if r["state"] in ("APPROVED", "CHANGES_REQUESTED"):
            latest[r["author"]["login"]] = r
    print(json.dumps({"data": {"repository": {"pullRequest": {
        "mine": {"nodes": mine}, "everyone": {"nodes": everyone[-100:]},
        "opinionated": {"nodes": list(latest.values())}}}}}))
elif args[:2] == ["pr", "list"] and "--search" in args:
    print(json.dumps([record(pr) for pr in queue]))
elif args[:2] == ["pr", "list"]:
    print(json.dumps([record(pr) for pr in queue + others]))
else:
    sys.exit(f"unexpected gh call {args}")
'''


class ReviewQueueTests(unittest.TestCase):
    def setUp(self):
        temp = tempfile.TemporaryDirectory()
        self.addCleanup(temp.cleanup)
        self.root = Path(os.path.realpath(temp.name))
        self.origin = self.root / "origin.git"
        self.repo = self.root / "repo"
        subprocess.run(["git", "init", "-q", "--bare", "-b", "main", str(self.origin)], check=True)
        subprocess.run(["git", "clone", "-q", str(self.origin), str(self.repo)], check=True,
                       capture_output=True)
        self.git("commit", "-q", "--allow-empty", "-m", "base")
        self.git("push", "-q", "origin", "main")
        bin_dir = self.root / "bin"
        bin_dir.mkdir()
        (bin_dir / "gh").write_text(FAKE_GH)
        (bin_dir / "gh").chmod(0o755)
        self.queue_file = self.root / "queue.json"
        self.env = dict(os.environ)
        self.env.update({"PATH": f"{bin_dir}{os.pathsep}{self.env['PATH']}",
                         "FAKE_ORIGIN": str(self.origin), "FAKE_QUEUE": str(self.queue_file)})
        self.queue([])

    def git(self, *args, cwd=None):
        return subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@t", "-C",
                               str(cwd or self.repo), *args], check=True, capture_output=True,
                              text=True).stdout.strip()

    def push(self, number, parent=None):
        """Add a commit to a PR's head on origin, on `parent` when given (a force-push)."""
        base = parent or subprocess.run(
            ["git", "-C", str(self.origin), "rev-parse", "-q", "--verify", f"refs/pull/{number}/head"],
            capture_output=True, text=True).stdout.strip() or "main"
        tree = self.git("rev-parse", f"{base}^{{tree}}", cwd=self.origin)
        sha = self.git("commit-tree", tree, "-p", base, "-m", f"push to {number}", cwd=self.origin)
        self.git("update-ref", f"refs/pull/{number}/head", sha, cwd=self.origin)
        return sha

    def queue(self, prs, others=()):
        """Set the PRs awaiting my review, and other open PRs that aren't."""
        for pr in [*prs, *others]:
            if not subprocess.run(["git", "-C", str(self.origin), "rev-parse", "-q", "--verify",
                                   f"refs/pull/{pr['number']}/head"], capture_output=True).stdout:
                self.push(pr["number"])
        self.queue_file.write_text(json.dumps(prs))
        self.env["FAKE_OPEN"] = json.dumps(list(others))

    def run_queue(self, *args):
        return subprocess.run([sys.executable, str(SCRIPT), *args], cwd=self.repo,
                              capture_output=True, text=True, env=self.env)

    def helper(self, *args, code=0):
        result = self.run_queue(*args)
        self.assertEqual(result.returncode, code, result.stdout + result.stderr)
        return json.loads(result.stdout)

    def items(self, mode="--all"):
        return {item["number"]: item for item in self.helper(mode)["items"]}

    def head(self, number):
        return self.git("rev-parse", f"refs/pull/{number}/head", cwd=self.origin)

    def test_a_pr_is_reviewed_only_when_my_review_is_at_its_current_head(self):
        old = self.push(5)
        self.push(5)
        self.queue([
            {"number": 1, "reviews": [["kris", 1]]},                # mine, at the head
            {"number": 2, "reviews": [["ada", 2]]},                 # someone else's, at the head
            {"number": 3, "reviews": [["kris", None]]},             # mine, commit gone after a force-push
            {"number": 4, "reviews": [["kris", 4, "PENDING"]]},     # my unsubmitted draft
            {"number": 5, "reviews": [["kris", old], ["ada", 5]]},  # mine, at an older head
            {"number": 6},
            {"number": 7, "reviews": [["kris", 7, "COMMENTED", ""]]},          # a lone thread reply
            {"number": 8, "reviews": [["kris", 8, "DISMISSED"]]},              # dismissed
            {"number": 9, "reviews": [["kris", 9, "APPROVED", ""]]},           # approved, no body
            {"number": 10, "reviews": [["kris", 10, "CHANGES_REQUESTED", ""]]},
            {"number": 11, "reviews": [["kris", 11, "COMMENTED", ""], ["kris", 11]]},
        ])
        states = {n: item["state"] for n, item in self.items().items()}
        self.assertEqual(states, {1: "reviewed", 2: "new", 3: "new", 4: "new", 5: "new", 6: "new",
                                  7: "new", 8: "new", 9: "reviewed", 10: "reviewed", 11: "reviewed"})

        # A push after my review makes it new again.
        reviewed = self.head(1)
        self.push(1)
        self.queue([{"number": 1, "reviews": [["kris", reviewed]]}])
        self.assertEqual(self.items()[1]["state"], "new")

    def test_ready_leaves_out_reviewed_prs_and_all_keeps_them(self):
        self.queue([{"number": 1, "reviews": [["kris", 1, "APPROVED", ""]]}, {"number": 2}])
        self.assertEqual({n: i["state"] for n, i in self.items("--all").items()},
                         {1: "reviewed", 2: "new"})
        self.assertEqual({n: i["state"] for n, i in self.items("--ready").items()}, {2: "new"})

    def test_other_reviewers_leave_out_me_the_author_bots_and_reviews_that_dont_count(self):
        old = self.push(1)
        self.push(1)
        self.queue([
            {"number": 1, "reviews": [["kris", 1], ["ada", 1], ["grace", old], ["copilot[bot]", 1],
                                      ["linus", 1, "COMMENTED", ""], ["ken", 1, "DISMISSED"],
                                      ["barbara", 1, "APPROVED", ""]]},
            {"number": 2, "reviews": [["kris", 2]]},
            # An approval pushed out of the last 100 reviews by thread replies.
            {"number": 3, "reviews": [["grace", 3, "APPROVED", ""]]
                                     + [["ada", 3, "COMMENTED", ""]] * 100},
        ])
        items = self.items()
        self.assertEqual(items[1]["other_reviewers"], ["barbara", "grace"])
        self.assertEqual(items[2]["other_reviewers"], [])
        self.assertEqual(items[3]["other_reviewers"], ["grace"])

    def test_exactly_one_mode_is_required(self):
        for args in ([], ["--all", "--ready"]):
            result = self.run_queue(*args)
            self.assertEqual(result.returncode, 2, args)
            self.assertIn("usage:", result.stderr)

    def test_items_carry_exactly_the_fields_callers_read(self):
        # The Herdr reviews mod reads these names; a change here breaks it.
        self.queue([{"number": 1, "changed_files": 7}])
        output = self.helper("--all")
        self.assertEqual(set(output), {"items"})
        item = output["items"][0]
        self.assertEqual(set(item), ITEM_KEYS)
        self.assertEqual(item["size"], {"additions": 1, "deletions": 1, "files": 7})
        self.assertEqual(item["head_sha"], self.head(1))

    def test_stacked_on_and_jira_keys(self):
        self.queue([
            {"number": 1, "head": "nxc-5-api"},
            {"number": 2, "base": "nxc-5-api", "head": "nxc-5-ui"},
            {"number": 3, "title": "Tidy db", "head": "tidy-db"},
            {"number": 4, "base": "abc-9-model"},
        ], others=[{"number": 9, "head": "abc-9-model"}])
        items = self.items()
        self.assertEqual({n: i["stacked_on"] for n, i in items.items()}, {1: None, 2: 1, 3: None, 4: 9})
        self.assertEqual(items[1]["jira_keys"], ["NXC-5"])
        self.assertEqual(items[3]["jira_keys"], [])
        self.assertEqual({item["state"] for item in items.values()}, {"new"})

    def test_a_cross_repository_pr_is_never_stacked_on(self):
        # A fork's PR whose head branch is main must not sit under every PR based on main.
        self.queue([{"number": 1}], others=[{"number": 2, "head": "main", "cross_repository": True}])
        self.assertIsNone(self.items()[1]["stacked_on"])

    def test_not_a_git_checkout_needs_judgment(self):
        result = self.run_queue("--all", "--repo", str(self.root))
        self.assertEqual(result.returncode, 2, result.stderr)
        self.assertEqual(json.loads(result.stdout)["status"], "needs_judgment")

    def test_a_failed_gh_call_exits_1_with_a_message(self):
        self.queue_file.write_text("not json")
        result = self.run_queue("--all")
        self.assertEqual(result.returncode, 1)
        self.assertTrue(result.stderr.startswith("github-review-queue: "), result.stderr)


if __name__ == "__main__":
    unittest.main()
