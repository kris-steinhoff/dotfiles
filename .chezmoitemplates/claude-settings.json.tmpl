{
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults"
    ],
    "environment": [
      "$defaults"
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "aws-core@agent-toolkit-for-aws": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "repo": "addyosmani/agent-skills",
        "source": "github"
      }
    },
    "agent-toolkit-for-aws": {
      "source": {
        "repo": "aws/agent-toolkit-for-aws",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/sort-settings-json.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "user_settings"
      }
    ],
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "command": "sh ~/.claude/hooks/wt-worktree-create.sh",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "command": "sh ~/.claude/hooks/wt-worktree-remove.sh",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "additionalDirectories": [
      "~/scratch"
    ],
    "allow": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)"
    ]
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "xcodebuild *",
      "xcrun simctl *",
      "xcrun xcresulttool *"
    ],
    "filesystem": {
      "allowRead": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowWrite": [
        "~/.cache/pre-commit",
        "~/.cache/uv",
        "~/.local/share/uv/tools",
        "~/.npm/_cacache",
        "~/.npm/_npx",
        "~/Library/Developer/Xcode/DerivedData",
        "~/Library/Developer/CoreSimulator",
        "~/Library/Caches/org.swift.swiftpm",
        "~/Library/org.swift.swiftpm",
        "~/.local/state/ai-usage",
        "~/Documents/Chief of Staff/inbox",
        "~/.herdr/worktrees",
        "~/orca/workspaces",
        "~/.dolt"{{ range get . "claudeSandboxAllowWrite" | default list }},
        {{ toJson . }}{{ end }}
      ],
      "denyRead": [
        "~/.ssh/agent",
        "~/.aws/credentials",
        "~/.aws/sso",
        "~/.aws/cli",
        "~/.aws/login",
        "~/.config/op",
        "~/Library/Application Support/glab-cli",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.CoreSimulator.CoreSimulatorService"
      ],
      "allowUnixSockets": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowedDomains": [
        "127.0.0.1",
        "localhost",
        "api.anthropic.com",
        "chatgpt.com",
        "openrouter.ai",
        "api.github.com",
        "github.com",
        "files.pythonhosted.org",
        "pypi.org",
        "registry.npmjs.org",
        "*.atlassian.net",
        "api.atlassian.com"
      ]
    }
  },
  "statusLine": {
    "command": "npx -y @owloops/claude-powerline@latest",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh"
  }
}
