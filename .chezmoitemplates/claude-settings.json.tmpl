{
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "GitHub PR Review Cleanup: Running the github-pr skill's own `dispatch.py` (at `skills/github-pr/scripts/dispatch.py` under the home directory's `~/.claude/` or `~/.agents/`) as `dispatch.py cleanup --apply`, optionally with `--repo <path>` and no other arguments, as its own command with nothing chained before or after it, is not Interfere With Workloads, Irreversible Local Destruction, or Irreversible Deletion. It removes only review worktrees that the github-pr skill created and that it verifies in the same run, closing each one's local Herdr workspace and idle reviewer agent, and deletes only local branches and refs. This does not apply if that script or a `.herdr-dispatch.json` marker was written or edited this session other than by the skill's own `dispatch.py`, and it does not cover the remove-worktree script, `git worktree remove`, or `herdr worktree remove` called directly."
    ],
    "environment": [
      "$defaults",
      "Review worktrees under a repository's `.worktrees/` that carry a `.herdr-dispatch.json` marker with a `github_pr_review` entry are created by the github-pr skill's `review ready` pass, each with its own Herdr workspace and one reviewer agent that idles there once the review is done. Herdr is a terminal multiplexer running on this machine, so its workspaces and agents are local. `dispatch.py cleanup --apply` removes such a worktree only when its pass is complete, its review is not requested again, and its checkout is clean at the reviewed head, and deletes its local branch only when the branch's commits are on the PR, so nothing it removes exists only locally; it never touches remote branches."
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "aws-core@agent-toolkit-for-aws": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "repo": "addyosmani/agent-skills",
        "source": "github"
      }
    },
    "agent-toolkit-for-aws": {
      "source": {
        "repo": "aws/agent-toolkit-for-aws",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/sort-settings-json.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "user_settings"
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "additionalDirectories": [
      "~/scratch"
    ],
    "defaultMode": "auto"
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "xcodebuild *",
      "xcrun simctl *",
      "xcrun xcresulttool *"
    ],
    "filesystem": {
      "allowRead": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowWrite": [
        "~/.cache/uv",
        "~/.local/state/drive-implementation",
        "~/.local/share/uv/tools",
        "~/.npm/_cacache",
        "~/Library/Developer/Xcode/DerivedData",
        "~/Library/Developer/CoreSimulator",
        "~/Library/Caches/org.swift.swiftpm",
        "~/Library/org.swift.swiftpm",
        "~/.local/state/ai-usage",
        "~/Documents/Chief of Staff/inbox",
        "~/.herdr/worktrees",
        "~/.dolt"{{ range get . "claudeSandboxAllowWrite" | default list }},
        {{ toJson . }}{{ end }}
      ],
      "denyRead": [
        "~/.ssh/agent",
        "~/.aws/credentials",
        "~/.aws/sso",
        "~/.aws/cli",
        "~/.aws/login",
        "~/.config/op",
        "~/Library/Application Support/glab-cli",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.CoreSimulator.CoreSimulatorService"
      ],
      "allowUnixSockets": [
        "~/.config/herdr/herdr.sock",
        "~/.config/herdr/herdr-client.sock",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowedDomains": [
        "127.0.0.1",
        "localhost",
        "api.anthropic.com",
        "chatgpt.com",
        "openrouter.ai",
        "api.github.com",
        "github.com",
        "files.pythonhosted.org",
        "pypi.org",
        "registry.npmjs.org",
        "*.atlassian.net",
        "api.atlassian.com"
      ]
    }
  },
  "statusLine": {
    "command": "npx -y @owloops/claude-powerline@latest",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh"
  }
}
