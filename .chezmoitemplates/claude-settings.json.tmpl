{
  "agentPushNotifEnabled": true,
  "autoMode": {
    "allow": [
      "$defaults",
      "GitHub PR Review Cleanup: Running the github-pr skill's own `dispatch.py` (at `skills/github-pr/scripts/dispatch.py` under the home directory's `~/.claude/` or `~/.agents/`) as `dispatch.py cleanup --apply`, optionally with `--repo <path>` and no other arguments, as its own command with nothing chained before or after it, is not Interfere With Workloads, Irreversible Local Destruction, or Irreversible Deletion. It closes only the terminal tabs of reviewer agents that the github-pr skill launched and recorded, and only once every PR it gave that reviewer is finished, so the agent it ends is idle with its work posted; it also deletes the skill's own private git refs under `refs/github-pr-review/`. This does not apply if that script or the queue's state file under `~/.local/state/github-pr/reviews/` was written or edited this session other than by the skill's own `dispatch.py`, and it does not cover `dispatch terminal close`, `herdr pane close`, or `orca terminal close` called directly."
    ],
    "environment": [
      "$defaults",
      "Reviewer tabs recorded in `~/.local/state/github-pr/reviews/<owner>/<repo>.json` are created by the github-pr skill's `review ready` pass, each running one interactive Claude reviewer that idles in its tab once its reviews are posted. Herdr and Orca are terminal workspace tools running on this machine, so their tabs and agents are local. `dispatch.py cleanup --apply` closes such a tab only when every PR its reviewer was given is finished; reviews read PRs from git without a checkout, so closing a tab loses no local work, and it never touches remote branches or GitHub."
    ]
  },
  "enabledPlugins": {
    "agent-skills@addy-agent-skills": true,
    "aws-core@agent-toolkit-for-aws": true,
    "swift-lsp@claude-plugins-official": true
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "repo": "addyosmani/agent-skills",
        "source": "github"
      }
    },
    "agent-toolkit-for-aws": {
      "source": {
        "repo": "aws/agent-toolkit-for-aws",
        "source": "github"
      }
    }
  },
  "feedbackDrafts": "off",
  "hooks": {
    "ConfigChange": [
      {
        "hooks": [
          {
            "command": "bash ~/.claude/hooks/sort-settings-json.sh",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "user_settings"
      }
    ]
  },
  "model": "opus",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "permissions": {
    "additionalDirectories": [
      "~/scratch"
    ],
    "allow": [
      "Bash(git push:*)"
    ],
    "defaultMode": "auto",
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push *+*)"
    ]
  },
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "sandbox": {
    "allowUnsandboxedCommands": false,
    "autoAllowBashIfSandboxed": true,
    "enabled": true,
    "excludedCommands": [
      "xcodebuild *",
      "xcrun simctl *",
      "xcrun xcresulttool *"
    ],
    "filesystem": {
      "allowRead": [
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowWrite": [
        "~/.cache/pre-commit",
        "~/.cache/uv",
        "~/.local/state/drive-implementation",
        "~/.local/state/github-pr",
        "~/.local/share/uv/tools",
        "~/.npm/_cacache",
        "~/.npm/_npx",
        "~/Library/Developer/Xcode/DerivedData",
        "~/Library/Developer/CoreSimulator",
        "~/Library/Caches/org.swift.swiftpm",
        "~/Library/org.swift.swiftpm",
        "~/.local/state/ai-usage",
        "~/Documents/Chief of Staff/inbox",
        "~/.herdr/worktrees",
        "~/orca/workspaces",
        "~/.dolt"{{ range get . "claudeSandboxAllowWrite" | default list }},
        {{ toJson . }}{{ end }}
      ],
      "denyRead": [
        "~/.ssh/agent",
        "~/.aws/credentials",
        "~/.aws/sso",
        "~/.aws/cli",
        "~/.aws/login",
        "~/.config/op",
        "~/Library/Application Support/glab-cli",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password"
      ]
    },
    "network": {
      "allowLocalBinding": true,
      "allowMachLookup": [
        "com.apple.CoreSimulator.CoreSimulatorService"
      ],
      "allowUnixSockets": [
        "~/.config/herdr/herdr.sock",
        "~/.config/herdr/herdr-client.sock",
        "~/Library/Application Support/orca",
        "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
      ],
      "allowedDomains": [
        "127.0.0.1",
        "localhost",
        "api.anthropic.com",
        "chatgpt.com",
        "openrouter.ai",
        "api.github.com",
        "github.com",
        "files.pythonhosted.org",
        "pypi.org",
        "registry.npmjs.org",
        "*.atlassian.net",
        "api.atlassian.com"
      ]
    }
  },
  "statusLine": {
    "command": "npx -y @owloops/claude-powerline@latest",
    "type": "command"
  },
  "theme": "dark",
  "tui": "fullscreen",
  "worktree": {
    "baseRef": "fresh"
  }
}
