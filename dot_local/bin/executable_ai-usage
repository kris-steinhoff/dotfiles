#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["rich>=13"]
# ///
"""Show a live summary of current AI subscription usage.

Reads the local Claude Code and Codex sign-ins, then queries their respective
usage endpoints. It currently supports Claude and ChatGPT (via Codex), and
renders whichever limit windows each account reports.

On a terminal it refreshes in place until interrupted. `--once` prints a
single snapshot and exits. `--json` prints each provider's raw payload, and
`--json windows` prints every service's windows in one normalized shape for
programs that compare the two, such as choose-agent.

Every fetch goes through a shared cache in ~/.local/state/ai-usage/, so any
number of callers can run as often as they like: a caller fetches only when
the last attempt is older than its `--interval`, or a 429's backoff has lifted.
"""

from __future__ import annotations

import argparse
import contextlib
import fcntl
import json
import math
import os
import select
import subprocess
import sys
import tempfile
import termios
import time
import tty
import urllib.error
import urllib.request
from dataclasses import dataclass, replace
from datetime import datetime, timedelta, timezone
from email.utils import parsedate_to_datetime
from pathlib import Path

from rich.align import Align
from rich.console import Console, Group
from rich.live import Live
from rich.measure import Measurement
from rich.panel import Panel
from rich.table import Table
from rich.text import Text

CLAUDE_USAGE_URL = "https://api.anthropic.com/api/oauth/usage"
OAUTH_BETA = "oauth-2025-04-20"
CREDENTIALS_PATH = Path.home() / ".claude" / ".credentials.json"
KEYCHAIN_SERVICE = "Claude Code-credentials"  # macOS Keychain entry name
# Codex uses the ChatGPT backend's public compatibility route here; the
# `/api/codex/usage` spelling is for the newer internal deployment.
CHATGPT_USAGE_URL = "https://chatgpt.com/backend-api/wham/usage"
CODEX_AUTH_PATH = Path.home() / ".codex" / "auth.json"
STATE_DIR = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local" / "state") / "ai-usage"

BAR_WIDTH = 26

# Backoff to honor when a 429 arrives without a usable Retry-After hint.
DEFAULT_BACKOFF = 60.0
# Extra seconds added past a 429's stated deadline before retrying, so the retry
# lands after the window has actually cleared rather than at the exact boundary
# (where it tends to draw a fresh 429 with a full-window Retry-After).
RETRY_BUFFER = 3.0

console = Console()
err_console = Console(stderr=True)


class UsageError(Exception):
    """A recoverable failure to load credentials or fetch usage.

    Carries an optional one-line hint. Fatal at startup (single-shot), but in
    the live view it is shown in the footer while the previous data stays up.
    """

    def __init__(
        self,
        message: str,
        hint: str | None = None,
        retry_after: float | None = None,
        status: int | None = None,
        credentials_missing: bool = False,
    ):
        super().__init__(message)
        self.message = message
        self.hint = hint
        self.retry_after = retry_after
        self.status = status
        self.credentials_missing = credentials_missing


# --------------------------------------------------------------------------- #
# Credential loading
# --------------------------------------------------------------------------- #
def load_oauth() -> dict:
    """Return the claudeAiOauth blob from the file store or the macOS Keychain.

    Re-read on every poll so a long-running view picks up tokens that Claude
    Code has refreshed in the meantime.
    """
    raw = None
    if CREDENTIALS_PATH.exists():
        raw = CREDENTIALS_PATH.read_text()
    elif sys.platform == "darwin":
        try:
            raw = subprocess.run(
                ["security", "find-generic-password", "-s", KEYCHAIN_SERVICE, "-w"],
                capture_output=True,
                text=True,
                check=True,
            ).stdout.strip()
        except (subprocess.CalledProcessError, FileNotFoundError):
            raw = None

    if not raw:
        raise UsageError(
            "Could not find Claude credentials.",
            "Log in with Claude Code first (run `claude` and complete sign-in).",
            credentials_missing=True,
        )

    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        raise UsageError("Claude credentials are not valid JSON.")

    oauth = data.get("claudeAiOauth")
    if not oauth or not oauth.get("accessToken"):
        raise UsageError("No OAuth access token found in Claude credentials.", credentials_missing=True)
    return oauth


def load_chatgpt_oauth() -> dict:
    """Load Codex's ChatGPT access token, re-reading it on every poll."""
    if not CODEX_AUTH_PATH.exists():
        raise UsageError(
            "Could not find ChatGPT credentials.",
            "Log in with Codex first (run `codex` and complete sign-in).",
            credentials_missing=True,
        )
    try:
        data = json.loads(CODEX_AUTH_PATH.read_text())
    except json.JSONDecodeError:
        raise UsageError("ChatGPT credentials are not valid JSON.")

    tokens = data.get("tokens") or {}
    if not tokens.get("access_token"):
        raise UsageError("No OAuth access token found in ChatGPT credentials.", credentials_missing=True)
    return tokens


# --------------------------------------------------------------------------- #
# API
# --------------------------------------------------------------------------- #
def parse_retry_after(value: str | None) -> float | None:
    """Seconds to wait per an HTTP Retry-After header, or None if unusable.

    Accepts the numeric-seconds form ("42", "42.5") and the HTTP-date form,
    which is resolved to seconds-from-now (floored at 0). Never raises.
    """
    if not value:
        return None
    value = value.strip()
    try:
        return float(value)
    except ValueError:
        pass
    try:
        when = parsedate_to_datetime(value)
    except (TypeError, ValueError):
        return None
    if when is None or when.tzinfo is None:
        return None
    delta = (when - datetime.now(timezone.utc)).total_seconds()
    return max(0.0, delta)


def fetch_usage(token: str) -> dict:
    req = urllib.request.Request(
        CLAUDE_USAGE_URL,
        headers={
            "Authorization": f"Bearer {token}",
            "anthropic-beta": OAUTH_BETA,
            "User-Agent": "claude-usage-cli",
            "Accept": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise UsageError(
                f"{e.code} {e.reason}",
                hint="Open Claude Code once to refresh the stored token, then try again.",
                status=e.code,
            )
        if e.code == 429:
            retry = parse_retry_after(e.headers.get("Retry-After"))
            raise UsageError(f"{e.code} {e.reason}", retry_after=retry, status=e.code)
        raise UsageError(f"{e.code} {e.reason}", status=e.code)
    except urllib.error.URLError as e:
        raise UsageError(f"Could not reach the Claude usage API: {e.reason}")
    except TimeoutError:
        raise UsageError("Timed out contacting the Claude usage API.")


def fetch_chatgpt_usage(oauth: dict) -> dict:
    """Fetch the same Codex allowance snapshot shown by ChatGPT."""
    headers = {
        "Authorization": f"Bearer {oauth['access_token']}",
        "User-Agent": "ai-usage-cli",
        "Accept": "application/json",
    }
    if oauth.get("account_id"):
        headers["ChatGPT-Account-Id"] = oauth["account_id"]
    req = urllib.request.Request(CHATGPT_USAGE_URL, headers=headers)
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            raise UsageError(
                f"{e.code} {e.reason}",
                hint="Open Codex once to refresh the stored token, then try again.",
                status=e.code,
            )
        if e.code == 429:
            retry = parse_retry_after(e.headers.get("Retry-After"))
            raise UsageError(f"{e.code} {e.reason}", retry_after=retry, status=e.code)
        raise UsageError(f"{e.code} {e.reason}", status=e.code)
    except urllib.error.URLError as e:
        raise UsageError(f"Could not reach the ChatGPT usage API: {e.reason}")
    except TimeoutError:
        raise UsageError("Timed out contacting the ChatGPT usage API.")


# --------------------------------------------------------------------------- #
# Model
# --------------------------------------------------------------------------- #
@dataclass
class Window:
    label: str
    percent: float | None
    resets_at: str | None = None
    severity: str | None = None
    used_dollars: float | None = None
    limit_dollars: float | None = None
    active: bool = True
    # Show the share left rather than used, matching how the provider's own
    # usage page reads. `percent` and severity still measure usage.
    show_remaining: bool = False
    # Stable identity and length for `--json windows`; the display ignores them.
    key: str | None = None
    window_seconds: float | None = None

    @property
    def is_dollar(self) -> bool:
        return self.limit_dollars is not None

    @property
    def pct(self) -> float:
        if self.percent is not None:
            return max(0.0, min(100.0, float(self.percent)))
        if self.is_dollar and self.limit_dollars:
            return max(0.0, min(100.0, 100.0 * (self.used_dollars or 0) / self.limit_dollars))
        return 0.0


# Named windows the endpoint may return, in display order: (key, label, limit-kind).
# limit-kind links a window to its entry in the limits[] array so the server's
# own severity can be used. Windows with no matching kind (the per-model splits)
# fall back to percent-based coloring rather than borrowing the aggregate's.
NAMED_WINDOWS: list[tuple[str, str, str | None]] = [
    ("five_hour", "Session · 5h", "session"),
    ("seven_day", "Week · all models", "weekly_all"),
    ("seven_day_opus", "Week · Opus", "weekly_opus"),
    ("seven_day_sonnet", "Week · Sonnet", "weekly_sonnet"),
    ("seven_day_cowork", "Week · Cowork", None),
    ("seven_day_oauth_apps", "Week · Apps", None),
]
# The Claude endpoint names its windows rather than stating their length.
HOUR = 3600
WINDOW_SECONDS = {"five_hour": 5 * HOUR}
WEEK_SECONDS = 7 * 24 * HOUR


def build_windows(data: dict) -> list[Window]:
    # Severity per limit kind, from the limits[] array (authoritative thresholds).
    severity_by_kind: dict[str, str] = {}
    for lim in data.get("limits") or []:
        if lim.get("kind"):
            severity_by_kind[lim["kind"]] = lim.get("severity")

    windows: list[Window] = []
    for key, label, kind in NAMED_WINDOWS:
        w = data.get(key)
        if not isinstance(w, dict):
            continue
        util = w.get("utilization")
        # Skip windows the account does not use at all (null utilization, no dollars).
        if util is None and w.get("limit_dollars") is None:
            continue
        windows.append(
            Window(
                label=label,
                percent=util,
                resets_at=w.get("resets_at"),
                severity=severity_by_kind.get(kind) if kind else None,
                used_dollars=w.get("used_dollars"),
                limit_dollars=w.get("limit_dollars"),
                key=key,
                window_seconds=WINDOW_SECONDS.get(key, WEEK_SECONDS if key.startswith("seven_day") else None),
            )
        )

    # Enterprise "Claude Zero" accounts report no named windows; usage is tracked
    # as credit spend in the top-level `spend` block instead. Synthesize a single
    # dollar window from it so the account gets a real bar. extra_usage_line()
    # renders the same data, so it is skipped when this window is present.
    if not windows:
        spend = data.get("spend") or {}
        used = spend.get("used") or {}
        limit = spend.get("limit") or {}
        if spend.get("enabled") and used.get("amount_minor") is not None and limit.get("amount_minor") is not None:
            windows.append(
                Window(
                    label="Credits · monthly",
                    percent=None,
                    severity=spend.get("severity"),
                    used_dollars=used["amount_minor"] / (10 ** used.get("exponent", 2)),
                    limit_dollars=limit["amount_minor"] / (10 ** limit.get("exponent", 2)),
                    key="credits",
                )
            )

    return windows


def chatgpt_reset_at(value: object) -> str | None:
    """Normalize Codex's Unix reset timestamp to the ISO form used by Window."""
    if isinstance(value, (int, float)):
        return datetime.fromtimestamp(value, timezone.utc).isoformat()
    return value if isinstance(value, str) else None


def chatgpt_window_reset(limit: dict) -> str | None:
    """Return a reset time across the usage endpoint's known field spellings."""
    absolute = limit.get("resets_at", limit.get("reset_at"))
    normalized = chatgpt_reset_at(absolute)
    if normalized is not None:
        return normalized
    remaining = limit.get("reset_after_seconds")
    if isinstance(remaining, (int, float)):
        return (datetime.now(timezone.utc) + timedelta(seconds=remaining)).isoformat()
    return None


def build_chatgpt_windows(data: dict) -> list[Window]:
    """Adapt Codex's rate-limit snapshot to the shared display model.

    Codex returns one or two named windows plus optional feature-specific
    allowances. The endpoint has changed shape before, so accept both the
    top-level and nested `rate_limits` representations.
    """
    limits = data.get("rate_limits") if isinstance(data.get("rate_limits"), dict) else data.get("rate_limit", data)
    windows: list[Window] = []
    for key, label in (
        ("primary", "Codex · primary"),
        ("secondary", "Codex · secondary"),
        ("primary_window", "Codex · primary"),
        ("secondary_window", "Codex · secondary"),
    ):
        limit = limits.get(key)
        if not isinstance(limit, dict) or limit.get("used_percent") is None:
            continue
        minutes = limit.get("window_minutes")
        if minutes is None and isinstance(limit.get("limit_window_seconds"), (int, float)):
            minutes = limit["limit_window_seconds"] / 60
        suffix = f" · {minutes // 60:g}h" if isinstance(minutes, (int, float)) and minutes < 1440 else ""
        if isinstance(minutes, (int, float)) and minutes >= 1440:
            suffix = f" · {minutes / 1440:g}d"
        windows.append(
            Window(
                label=label + suffix,
                percent=limit["used_percent"],
                resets_at=chatgpt_window_reset(limit),
                show_remaining=True,
                key=key.removesuffix("_window"),
                window_seconds=minutes * 60 if isinstance(minutes, (int, float)) else None,
            )
        )
    for limit in data.get("additional_rate_limits") or limits.get("additional_rate_limits") or []:
        if not isinstance(limit, dict) or limit.get("used_percent") is None:
            continue
        name = str(limit.get("limit_name") or "Additional allowance")
        windows.append(
            Window(
                label=name,
                percent=limit["used_percent"],
                resets_at=chatgpt_window_reset(limit),
                show_remaining=True,
                key=f"additional:{name}",
            )
        )
    return windows


# --------------------------------------------------------------------------- #
# Rendering
# --------------------------------------------------------------------------- #
def severity_color(w: Window) -> str:
    if w.severity:
        return {
            "normal": "green",
            "low": "green",
            "warning": "yellow",
            "elevated": "yellow",
            "high": "dark_orange",
            "critical": "red",
        }.get(w.severity, "green")
    p = w.pct
    if p >= 90:
        return "red"
    if p >= 75:
        return "dark_orange"
    if p >= 50:
        return "yellow"
    return "green"


def bar(w: Window, width: int) -> Text:
    color = severity_color(w)
    shown = 100.0 - w.pct if w.show_remaining else w.pct
    filled = round(shown / 100 * width)
    filled = max(0, min(width, filled))
    # Show at least a sliver while any of the shown share remains.
    if filled == 0 and shown > 0:
        filled = 1
    t = Text()
    if w.show_remaining:
        # Anchor a falling share to the right, so it drains from the left and
        # its edge sits where a climbing bar's would for the same usage.
        t.append("░" * (width - filled), style="grey37")
        t.append("█" * filled, style=color)
    else:
        t.append("█" * filled, style=color)
        t.append("░" * (width - filled), style="grey37")
    return t


def amount_text(w: Window) -> Text:
    color = severity_color(w)
    if w.is_dollar:
        used = w.used_dollars or 0.0
        limit = w.limit_dollars or 0.0
        return Text(f"${used:,.2f} / ${limit:,.2f}", style=color)
    if w.show_remaining:
        return Text(f"{100.0 - w.pct:.0f}% left", style=f"bold {color}")
    return Text(f"{w.pct:.0f}% used", style=f"bold {color}")


def reset_text(resets_at: str | None) -> Text:
    if not resets_at:
        return Text("", style="grey50")
    when = parse_iso(resets_at)
    if when is None:
        return Text("", style="grey50")
    delta = (when - datetime.now(timezone.utc)).total_seconds()
    if delta <= 0:
        return Text("resetting…", style="grey50")
    return Text(f"resets in {humanize(delta)}", style="grey50")


def parse_iso(s: str) -> datetime | None:
    try:
        dt = datetime.fromisoformat(s)
    except ValueError:
        return None
    return dt if dt.tzinfo else dt.replace(tzinfo=timezone.utc)


def humanize(seconds: float) -> str:
    m = int(seconds // 60)
    d, rem = divmod(m, 1440)
    h, mins = divmod(rem, 60)
    if d:
        return f"{d}d {h}h"
    if h:
        return f"{h}h {mins}m"
    return f"{mins}m"


def extra_usage_line(data: dict) -> Text | None:
    """Summarize pay-as-you-go credits, if the account has them enabled."""
    extra = data.get("extra_usage") or {}
    spend = data.get("spend") or {}
    if not (extra.get("is_enabled") or spend.get("enabled")):
        return None
    used = spend.get("used") or {}
    amount = used.get("amount_minor")
    exponent = used.get("exponent", 2)
    currency = used.get("currency", "USD")
    limit_minor = (spend.get("limit") or {}).get("amount_minor") if isinstance(spend.get("limit"), dict) else None
    parts = Text("Extra usage  ", style="cyan")
    if amount is not None:
        spent = amount / (10**exponent)
        text = f"${spent:,.2f} {currency} used"
        if limit_minor is not None:
            text += f" of ${limit_minor / (10 ** exponent):,.2f}"
        parts.append(text, style="white")
    else:
        parts.append("enabled", style="white")
    return parts


def account_subtitle(oauth: dict) -> Text:
    # Just the plan (enterprise / pro / max); it distinguishes accounts. The
    # rateLimitTier string ("default_claude_zero" etc.) adds no signal the
    # usage bars don't already convey, so it is not shown.
    sub = (oauth.get("subscriptionType") or "unknown").replace("_", " ")
    return Text(sub, style="magenta")


def panel_title(title: str, account: Text | None) -> Text:
    """Put the account plan at the right end of the panel's top border."""
    text = Text(title, style="bold")
    if account is not None:
        # Panel reserves six cells for its borders and the spaces surrounding
        # the title. Use the rest to keep the account type against the right edge.
        gap = max(1, console.width - 8 - text.cell_len - account.cell_len)
        text.append(" ")
        text.append("─" * gap, style="grey42")
        text.append(" ")
        text.append_text(account)
    return text


FLASH_SECONDS = 1.0  # how long the timestamp stays bright right after a refresh


def updated_cell(updated_at: datetime | None, fresh_age: float | None) -> Text:
    if updated_at is None:
        return Text("")
    # Flash the time bright the moment it updates, then snap to dim — a single
    # bright→dim step, no gradual fade in between.
    bright = fresh_age is not None and fresh_age < FLASH_SECONDS
    t = Text("updated at ", style="grey50")
    t.append(updated_at.strftime("%H:%M"), style="bold white" if bright else "grey50")
    return t


def error_lines(error: UsageError, retry_remaining: float | None) -> list[Text]:
    """A red 'Error: …' line. While backing off, the retry countdown is appended
    to it in grey (same line); otherwise the error's hint goes on a second line."""
    first = Text(f"Error: {error.message}", style="red")
    if retry_remaining is not None:
        first.append(f"   retrying in {math.ceil(retry_remaining)} seconds", style="grey62")
        return [first]
    if error.hint:
        return [first, Text(error.hint, style="grey62")]
    return [first]


def build_panel(
    data: dict,
    oauth: dict | None = None,
    footer: Text | Group | None = None,
    updated_at: datetime | None = None,
    fresh_age: float | None = None,
    label_width: int | None = None,
    *,
    title: str = "Claude Usage",
    account: Text | None = None,
    window_builder=build_windows,
) -> Panel:
    windows = window_builder(data)
    body: list = []

    if not windows:
        body.append(Align.center(Text("No active usage windows reported.", style="grey62")))
    else:
        updated = updated_cell(updated_at, fresh_age)

        def build_table(include_updated: bool) -> Table:
            # Expand only when showing "updated at", so the flexible last column
            # can push it to the panel's right edge; otherwise the row stays its
            # natural width.
            t = Table.grid(padding=(0, 2), expand=include_updated)
            t.add_column(justify="left", no_wrap=True, width=label_width)  # label
            t.add_column(justify="left", no_wrap=True)   # bar
            t.add_column(justify="right", no_wrap=True)  # amount
            t.add_column(justify="left", no_wrap=True)   # reset
            if include_updated:
                # Right-justified and flexible: absorbs the slack and sits at the edge.
                t.add_column(justify="right", no_wrap=True, ratio=1)  # updated-at (row 0 only)
            for i, w in enumerate(windows):
                # A blank row between windows keeps adjacent bars from merging
                # into one block — two solid-green fills stacked flush read as a
                # single L-shape otherwise.
                if i > 0:
                    t.add_row()
                cells = [
                    Text(w.label, style="bold white"),
                    bar(w, BAR_WIDTH),
                    amount_text(w),
                    reset_text(w.resets_at),
                ]
                if include_updated:
                    cells.append(updated if i == 0 else Text(""))
                t.add_row(*cells)
            return t

        # Show "updated at" only when the row still fits; on a narrow terminal
        # drop it rather than let the row overflow. Panel chrome is the border (2)
        # plus horizontal padding (2*2).
        table = build_table(updated.cell_len > 0)
        if updated.cell_len > 0:
            if Measurement.get(console, console.options, table).maximum > console.width - 6:
                table = build_table(False)
        body.append(table)

        # The synthesized spend window already shows this data, so only add the
        # extra-usage summary when spend was not rendered as a window.
        if not any(w.label == "Credits · monthly" for w in windows):
            extra = extra_usage_line(data)
            if extra is not None:
                body.append(Text(""))
                body.append(extra)

    if footer is not None:
        body.append(Text(""))
        body.append(footer)

    return Panel(
        Group(*body),
        title=panel_title(title, account if account is not None else account_subtitle(oauth or {})),
        title_align="left",
        border_style="grey42",
        padding=(1, 2),
    )


def error_panel(error: UsageError, retry_remaining: float | None = None, title: str = "Claude Usage") -> Panel:
    body = [Align.center(line) for line in error_lines(error, retry_remaining)]
    return Panel(
        Group(*body),
        title=f"[bold]{title}[/bold]",
        title_align="left",
        border_style="red",
        padding=(1, 2),
    )


def wait_for_key(fd: int | None, timeout: float) -> str:
    """Sleep up to `timeout` seconds, returning an action for any key pressed.

    Returns "quit" for q/Q, a bare Esc, Ctrl-D, or closed stdin; "refresh" for
    Ctrl-R; "" otherwise. Ctrl-C already raises KeyboardInterrupt via ISIG.
    Requires the tty to be in cbreak mode (see run_live) so keystrokes arrive
    unbuffered. With no tty (fd is None) it just sleeps.
    """
    if fd is None:
        time.sleep(timeout)
        return ""
    ready, _, _ = select.select([fd], [], [], timeout)
    if not ready:
        return ""
    chunk = os.read(fd, 64)
    # b"" is a closed stdin; a lone Esc is a quit (arrow keys and the like
    # arrive as longer "\x1b[..." sequences, so only a bare Esc counts).
    if chunk in (b"", b"\x1b") or any(c in (0x04, ord("q"), ord("Q")) for c in chunk):
        return "quit"  # Ctrl-D, q, Q
    if 0x12 in chunk:  # Ctrl-R
        return "refresh"
    return ""


SERVICE_TITLES = {"claude": "Claude Usage", "chatgpt": "ChatGPT Usage"}


def fetch_service(service: str) -> tuple[dict, dict]:
    if service == "claude":
        oauth = load_oauth()
        return oauth, fetch_usage(oauth["accessToken"])
    oauth = load_chatgpt_oauth()
    return oauth, fetch_chatgpt_usage(oauth)


# --------------------------------------------------------------------------- #
# Shared cache
# --------------------------------------------------------------------------- #
@dataclass
class Cached:
    """One service's cache entry, shared by every caller on the machine.

    Times are wall-clock epoch seconds so separate processes agree on them.
    A failed attempt keeps the last good payload and records its error, so
    every caller backs off from it rather than each retrying on its own.
    """

    account: dict  # non-secret account details (Claude's plan); never tokens
    data: dict | None = None
    fetched_at: float | None = None  # last successful fetch
    attempted_at: float | None = None  # last fetch, successful or not
    error: UsageError | None = None
    retry_at: float | None = None  # no fetch before this, after a 429


def cache_path(service: str) -> Path:
    return STATE_DIR / f"{service}.json"


def read_cache(service: str) -> Cached:
    try:
        raw = json.loads(cache_path(service).read_text())
    except (OSError, json.JSONDecodeError):
        raw = None
    if not isinstance(raw, dict):
        return Cached(account={})
    err = raw.get("error")
    return Cached(
        account=raw.get("account") or {},
        data=raw.get("data"),
        fetched_at=raw.get("fetched_at"),
        attempted_at=raw.get("attempted_at"),
        error=UsageError(
            err.get("message", "Unknown error."),
            err.get("hint"),
            status=err.get("status"),
            credentials_missing=bool(err.get("credentials_missing")),
        ) if isinstance(err, dict) else None,
        retry_at=raw.get("retry_at"),
    )


def write_cache(service: str, entry: Cached) -> None:
    """Replace the entry atomically, so a concurrent reader never sees half a file."""
    err = entry.error
    payload = {
        "fetched_at": entry.fetched_at,
        "attempted_at": entry.attempted_at,
        "retry_at": entry.retry_at,
        "account": entry.account,
        "error": None if err is None else {
            "message": err.message,
            "hint": err.hint,
            "status": err.status,
            "credentials_missing": err.credentials_missing,
        },
        "data": entry.data,
    }
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=STATE_DIR, prefix=f".{service}.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(payload, f)
        os.replace(tmp, cache_path(service))
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


@contextlib.contextmanager
def service_lock(service: str):
    """Hold an exclusive per-service lock; without a writable state dir, run unlocked."""
    try:
        STATE_DIR.mkdir(parents=True, exist_ok=True)
        f = open(STATE_DIR / f"{service}.lock", "a")
    except OSError:
        yield
        return
    with f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def fetch_due(entry: Cached, max_age: float, now: float, force: bool) -> bool:
    # A 429's backoff binds even a forced refresh, since forcing through it
    # only draws another 429. Once it lifts, the retry is due straight away.
    if entry.retry_at is not None:
        return now >= entry.retry_at
    if force:
        return True
    return entry.attempted_at is None or now - entry.attempted_at >= max_age


def load_service(service: str, max_age: float, force: bool = False) -> Cached:
    """Return the service's cached usage, fetching first if it is due."""
    requested = time.time()
    entry = read_cache(service)
    if not fetch_due(entry, max_age, requested, force):
        return entry
    with service_lock(service):
        entry = read_cache(service)
        # Another caller may have fetched while this one waited on the lock;
        # its result is as new as this caller asked for, forced or not.
        if (entry.attempted_at or 0) >= requested or not fetch_due(entry, max_age, time.time(), force):
            return entry
        now = time.time()
        try:
            oauth, data = fetch_service(service)
        except UsageError as e:
            retry_at = None
            if e.status == 429:
                # Clamp 0.0/None to the default so a bogus Retry-After near
                # zero doesn't turn into a hammering loop.
                retry_at = time.time() + (e.retry_after or DEFAULT_BACKOFF) + RETRY_BUFFER
            entry = replace(entry, attempted_at=now, error=e, retry_at=retry_at)
        else:
            account = {"subscriptionType": oauth.get("subscriptionType")} if service == "claude" else {}
            entry = Cached(account=account, data=data, fetched_at=now, attempted_at=now)
        # An unwritable state dir costs only the sharing, not this caller's result.
        with contextlib.suppress(OSError):
            write_cache(service, entry)
        return entry


# --------------------------------------------------------------------------- #
# Views
# --------------------------------------------------------------------------- #
def service_panel(
    service: str,
    account: dict,
    data: dict,
    updated_at: datetime | None,
    fresh_age: float | None,
    label_width: int | None = None,
    footer: Text | Group | None = None,
) -> Panel:
    if service == "claude":
        return build_panel(
            data, account, footer, updated_at=updated_at, fresh_age=fresh_age, label_width=label_width,
        )
    plan = (data.get("plan_type") or "ChatGPT").replace("_", " ")
    return build_panel(
        data,
        footer=footer,
        updated_at=updated_at,
        fresh_age=fresh_age,
        label_width=label_width,
        title=SERVICE_TITLES[service],
        account=Text(plan, style="magenta"),
        window_builder=build_chatgpt_windows,
    )


def build_dashboard(services: list[str], entries: dict[str, Cached], now: float) -> Group:
    labels = [
        window.label
        for service in services
        if entries[service].data is not None
        for window in (build_windows if service == "claude" else build_chatgpt_windows)(entries[service].data)
    ]
    label_width = max((Text(label).cell_len for label in labels), default=None)
    panels: list[Panel] = []
    for service in services:
        entry = entries[service]
        retry_remaining = (
            entry.retry_at - now
            if entry.error is not None and entry.retry_at is not None and now < entry.retry_at
            else None
        )
        if entry.data is None:
            error = entry.error or UsageError("No usage fetched yet.")
            panels.append(error_panel(error, retry_remaining, title=SERVICE_TITLES[service]))
            continue
        footer = Group(*error_lines(entry.error, retry_remaining)) if entry.error is not None else None
        updated_at = datetime.fromtimestamp(entry.fetched_at) if entry.fetched_at is not None else None
        fresh_age = now - entry.fetched_at if entry.fetched_at is not None else None
        panels.append(service_panel(service, entry.account, entry.data, updated_at, fresh_age, label_width, footer))
    return Group(*panels)


def visible(services: list[str], entries: dict[str, Cached]) -> list[str]:
    """Hide a service the user is not signed in to, rather than show it as an error."""
    return [
        service for service in services
        if not (entries[service].error is not None and entries[service].error.credentials_missing)
    ]


def run_live(services: list[str], interval: int) -> None:
    """Redraw once a second from the shared cache, fetching whenever an entry is due.

    Reading the cache every tick also picks up refreshes made by other callers.
    """
    force = False
    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    saved_attrs = termios.tcgetattr(fd) if fd is not None else None
    # Silence keystroke echo while the Live view owns the screen. Echoed
    # characters shove Rich's render region and leave stacked, ghosted panels.
    # cbreak drops ECHO and line-buffering but keeps ISIG, so Ctrl-C still quits.
    if fd is not None:
        tty.setcbreak(fd)
    try:
        with Live(console=console, auto_refresh=False, screen=False) as live:
            try:
                while True:
                    entries = {service: load_service(service, interval, force) for service in services}
                    force = False
                    live.update(build_dashboard(visible(services, entries), entries, time.time()), refresh=True)
                    action = wait_for_key(fd, 1.0)
                    if action == "quit":
                        break
                    if action == "refresh":
                        force = True
            except KeyboardInterrupt:
                pass
    finally:
        if fd is not None and saved_attrs is not None:
            termios.tcflush(fd, termios.TCIFLUSH)  # drop keys typed during the run
            termios.tcsetattr(fd, termios.TCSADRAIN, saved_attrs)


# --------------------------------------------------------------------------- #
# Helpers
# --------------------------------------------------------------------------- #
def windows_json(service: str, entry: Cached) -> dict:
    """One service's windows in the shape shared across providers.

    `status` is `ok`, `stale` (an older payload kept after a failed fetch),
    `error` (no payload at all), or `signed_out`. A consumer can tell a
    service that is not set up from one whose usage is merely unknown.
    """
    if entry.error is not None and entry.error.credentials_missing:
        status = "signed_out"
    elif entry.data is None:
        status = "error"
    elif entry.error is not None:
        status = "stale"
    else:
        status = "ok"
    windows = []
    if entry.data is not None:
        built = build_windows(entry.data) if service == "claude" else build_chatgpt_windows(entry.data)
        windows = [
            {
                "key": w.key,
                "label": w.label,
                "used_percent": round(w.pct, 1),
                "window_seconds": w.window_seconds,
                "resets_at": w.resets_at,
            }
            for w in built
        ]
    return {
        "status": status,
        "fetched_at": datetime.fromtimestamp(entry.fetched_at, timezone.utc).isoformat() if entry.fetched_at else None,
        "error": entry.error.message if entry.error is not None else None,
        "windows": windows,
    }


def die(*lines: str) -> None:
    err_console.print(f"[red]error:[/red] {lines[0]}")
    for extra in lines[1:]:
        err_console.print(f"       [grey62]{extra}[/grey62]")
    sys.exit(1)


def die_on(service: str, error: UsageError) -> None:
    die(f"{SERVICE_TITLES[service]}: {error.message}", *([error.hint] if error.hint else []))


def main() -> None:
    parser = argparse.ArgumentParser(description="Show current AI subscription usage.")
    parser.add_argument(
        "--service", choices=("claude", "chatgpt"), action="append",
        help="show only this service (repeatable; default: both)",
    )
    parser.add_argument(
        "--json", nargs="?", const="raw", choices=("raw", "windows"),
        help="print JSON keyed by service and exit: each provider's raw payload (the default), "
             "or `windows` for every service's windows in one normalized shape",
    )
    parser.add_argument("--once", action="store_true", help="print a single snapshot instead of the live view")
    parser.add_argument(
        "-n", "--interval", type=int, default=300, metavar="SECONDS",
        help="fetch only when the shared cache is older than this many seconds "
             "(default: 300 / 5 minutes, minimum: 5)",
    )
    args = parser.parse_args()
    services = args.service or ["claude", "chatgpt"]
    interval = max(5, args.interval)

    if args.json == "windows":
        # Never fatal: a consumer wants every service's status, failures included.
        entries = {service: load_service(service, interval) for service in services}
        json.dump({service: windows_json(service, e) for service, e in entries.items()}, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return

    if args.json:
        entries = {service: load_service(service, interval) for service in services}
        for service, entry in entries.items():
            if entry.error is None or entry.error.credentials_missing:
                continue
            if entry.data is None:
                die_on(service, entry.error)
            # Stale data still prints, so a consumer keeps working; say why it is stale.
            err_console.print(f"[yellow]warning:[/yellow] {SERVICE_TITLES[service]}: {entry.error.message}; showing cached data")
        json.dump({service: e.data for service, e in entries.items() if e.data is not None}, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return

    # The live view needs a terminal; anything else prints once and exits.
    if args.once or not sys.stdout.isatty():
        entries = {service: load_service(service, interval) for service in services}
        if all(entry.data is None for entry in entries.values()):
            for service, entry in entries.items():
                if entry.error is not None and not entry.error.credentials_missing:
                    die_on(service, entry.error)
            return
        console.print(build_dashboard(visible(services, entries), entries, time.time()))
        return

    run_live(services, interval)


if __name__ == "__main__":
    main()
