#!/usr/bin/env python3
"""Remove one worktree and close its Herdr workspace. Destructive, fail-closed.

A Herdr dispatch teardown primitive. Git decides what a worktree is and whether
it is gone: the target must be one `git worktree list` registers, and success
is reported only once git no longer lists it. Herdr only supplies the
workspace. With an open workspace, `herdr worktree remove --workspace <id>`
removes the worktree and closes the workspace in one call; with none (it was
closed earlier), `git worktree remove` removes it. Branches (local and PR-head
refs) are left untouched.

Because teardown is destructive it is fail-closed. Unless `--force` is given, it
refuses (needs-judgment, with a specific reason) when any of these hold:

  1. The tree is dirty (uncommitted changes).
  2. The branch's work isn't verifiably pushed: no upstream configured at all
     (even with zero commits — a brand-new branch is still unverified, not
     "has unpushed commits", so the two get distinct reasons), or real commits
     ahead of its upstream. No-upstream is treated as unsafe too, erring
     conservative.
  3. A live agent still occupies a pane in the worktree's workspace.
  4. It is the caller's own active workspace (open_workspace_id ==
     $HERDR_WORKSPACE_ID).

Past the gate (checks clean, or `--force`), it always passes `--force` to the
underlying `herdr worktree remove` or `git worktree remove`: our own checks are
the real safety validation, so their generic checks would only add friction.

Idempotent: a path git doesn't list and that no longer exists on disk is
already removed, a success. A path git doesn't list that still exists is
refused rather than reported removed, since it is a caller mistake (a folder
that holds worktrees, say), not a finished removal. So is a removal that
deleted the checkout but left git's record behind (a sandbox that can't write
the repo's .git/worktrees/ does this): git then lists it as prunable, and the
record needs `git worktree prune` from somewhere that can.

`--worktree` is a path or a Herdr workspace_id. The safety checks duplicate
inspect-worktree's logic on purpose — the primitives are flat atoms that don't
call each other (see the PRD's Composition and ownership).

Requires HERDR_ENV=1: the removal itself drives the `herdr` CLI.

Exit codes (shared across the Herdr dispatch primitives):
  0  success. The JSON result object is printed to stdout.
  2  needs judgment. An expected situation the script cannot resolve
     mechanically (not running inside Herdr, an unsafe removal without
     --force, a path that isn't a worktree, or a record left prunable).
     stdout is JSON, {"status": "needs_judgment", "reason": ...} plus any
     known partial fields. The caller's cue to apply judgment or ask.
  1  real error (an unexpected git/herdr failure). Diagnostics go to stderr.

All subprocesses are invoked as argv lists, never a shell string.
"""

import argparse
import json
import os
import subprocess
import sys


class HerdrError(Exception):
    """A herdr subprocess failed or returned something unparsable."""


def run(argv, cwd=None):
    return subprocess.run(argv, capture_output=True, text=True, cwd=cwd)


def emit_success(obj):
    print(json.dumps(obj))
    sys.exit(0)


def emit_judgment(reason, **partial):
    print(json.dumps({"status": "needs_judgment", "reason": reason, **partial}))
    sys.exit(2)


def emit_error(message):
    print(f"remove-worktree: {message}", file=sys.stderr)
    sys.exit(1)


def herdr_json(args):
    proc = run(["herdr", *args])
    if proc.returncode != 0:
        raise HerdrError(
            f"herdr {' '.join(args)} failed ({proc.returncode}): "
            f"{proc.stderr.strip() or proc.stdout.strip()}"
        )
    try:
        return json.loads(proc.stdout).get("result", {})
    except json.JSONDecodeError:
        raise HerdrError(f"herdr {' '.join(args)} returned non-JSON: {proc.stdout[:200]}")


def collect_dicts(obj, out=None):
    """Every dict node anywhere in a parsed JSON value, read defensively (herdr's
    subcommands don't agree on field placement or naming)."""
    if out is None:
        out = []
    if isinstance(obj, dict):
        out.append(obj)
        for value in obj.values():
            collect_dicts(value, out)
    elif isinstance(obj, list):
        for item in obj:
            collect_dicts(item, out)
    return out


def first_value(nodes, *keys):
    for node in nodes:
        for key in keys:
            if node.get(key):
                return node[key]
    return None


def herdr_worktree_entries(repo):
    result = herdr_json(["worktree", "list", "--cwd", repo])
    entries = None
    if isinstance(result, dict):
        entries = result.get("worktrees") or result.get("workspaces")
    if entries is None:
        entries = result if isinstance(result, list) else [result]
    return [entry for entry in entries if isinstance(entry, dict)]


def git_worktrees(repo):
    """Every worktree git registers for `repo`, main checkout first, as dicts
    with `path` (realpath) and `prunable` (git's reason, or None)."""
    proc = run(["git", "-C", repo, "worktree", "list", "--porcelain"])
    if proc.returncode != 0:
        raise HerdrError(f"git worktree list failed in {repo}: {proc.stderr.strip()}")
    worktrees = []
    for line in proc.stdout.splitlines():
        if line.startswith("worktree "):
            worktrees.append({"path": os.path.realpath(line[len("worktree "):]), "prunable": None})
        elif line.startswith("prunable") and worktrees:
            worktrees[-1]["prunable"] = line[len("prunable"):].strip() or "prunable"
    return worktrees


def git_entry(worktrees, path):
    real = os.path.realpath(path)
    return next((w for w in worktrees if w["path"] == real), None)


def herdr_workspaces(repo):
    """(realpath, open_workspace_id) for each worktree Herdr knows in `repo`."""
    found = []
    for entry in herdr_worktree_entries(repo):
        nodes = collect_dicts(entry)
        path = first_value(nodes, "path")
        workspace_id = first_value(nodes, "open_workspace_id", "workspace_id")
        found.append((os.path.realpath(path) if path else None, workspace_id))
    return found


def resolve(worktree, repo):
    """Resolve `worktree` (a path or workspace_id) to (path, workspace_id), where
    path is a non-main worktree git registers and workspace_id is its open Herdr
    workspace or None. Emits success when it is already gone, and needs-judgment
    when it isn't a worktree at all."""
    worktrees = git_worktrees(repo)
    workspaces = herdr_workspaces(repo)

    target = worktree
    by_id = [path for path, ws in workspaces if ws and ws == worktree]
    if by_id and not os.path.exists(worktree):
        if not by_id[0]:
            emit_judgment(f"Herdr workspace {worktree} has no worktree path", workspace_id=worktree)
        target = by_id[0]

    real = os.path.realpath(target)
    entry = git_entry(worktrees, real)
    if entry is None:
        nested = [w["path"] for w in worktrees if w["path"].startswith(real.rstrip(os.sep) + os.sep)]
        if nested:
            emit_judgment(
                f"{target} is not a worktree, but {len(nested)} worktree(s) sit under it; "
                "pass one worktree's own path",
                path=target, worktrees=nested,
            )
        if os.path.exists(real):
            emit_judgment(f"{target} is not a worktree git registers in {repo}", path=target)
        # Neither git nor the disk has it: already removed.
        emit_success({"removed": True, "path": target})
    if entry is worktrees[0]:
        emit_judgment(f"{target} is the repository's main checkout, not a linked worktree", path=target)

    workspace_id = next((ws for path, ws in workspaces if path == real and ws), None)
    return real, workspace_id


def git_out(path, *args):
    proc = run(["git", "-C", path, *args])
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def is_dirty(path):
    code, out, _ = git_out(path, "status", "--porcelain")
    return bool(out) if code == 0 else False


def upstream_ref(path):
    code, out, _ = git_out(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    return out if code == 0 and out else None


def ahead_of_upstream(path):
    """(ahead, has_upstream). ahead is None if it can't be computed."""
    upstream = upstream_ref(path)
    if not upstream:
        return None, False
    code, out, _ = git_out(path, "rev-list", "--left-right", "--count", f"{upstream}...HEAD")
    if code != 0 or len(out.split()) != 2:
        return None, True
    try:
        return int(out.split()[1]), True
    except ValueError:
        return None, True


def unpushed_reason(path):
    """None if the branch's work is verifiably pushed; else a reason specific to
    why it isn't, since "no upstream" and "N unpushed commits" are different
    situations that shouldn't share one message (a brand-new branch with zero
    commits still has no upstream, but it doesn't have "unpushed commits")."""
    ahead, has_upstream = ahead_of_upstream(path)
    if not has_upstream:
        return ("branch has no upstream configured, so its commits aren't "
                "verifiably pushed anywhere else")
    if ahead is None:
        return "could not determine how far the branch is ahead of its upstream"
    if ahead > 0:
        return f"branch is {ahead} commit(s) ahead of its upstream (unpushed)"
    return None


def pane_ids_in_workspace(workspace_id):
    result = herdr_json(["pane", "list", "--workspace", workspace_id])
    panes = result.get("panes") if isinstance(result, dict) else None
    if not panes:
        panes = [node for node in collect_dicts(result) if node.get("pane_id")]
    return {pane.get("pane_id") for pane in panes if pane.get("pane_id")}


def agent_live(workspace_id):
    if not workspace_id:
        return False
    try:
        pane_ids = pane_ids_in_workspace(workspace_id)
        if not pane_ids:
            return False
        result = herdr_json(["agent", "list"])
        agents = result.get("agents") if isinstance(result, dict) else result
        if not isinstance(agents, list):
            return False
        for agent in agents:
            if not isinstance(agent, dict):
                continue
            if any(node.get("pane_id") in pane_ids for node in collect_dicts(agent)):
                return True
        return False
    except HerdrError:
        return False


def do_remove(workspace_id, path, repo):
    """Remove the worktree (through Herdr when it has a workspace, else through
    git), then report removed only if git no longer lists it."""
    if workspace_id:
        argv = ["herdr", "worktree", "remove", "--workspace", workspace_id, "--force"]
    else:
        argv = ["git", "-C", repo, "worktree", "remove", "--force", path]
    proc = run(argv)
    detail = (proc.stderr or proc.stdout).strip()

    entry = git_entry(git_worktrees(repo), path)
    if entry is None:
        emit_success({"removed": True, "path": path})
    if entry["prunable"] and not os.path.exists(path):
        emit_judgment(
            "the checkout was deleted but git's record of it remains (prunable), "
            "likely because .git/worktrees/ isn't writable here; run "
            "`git worktree prune` where it is",
            path=path, workspace_id=workspace_id, checkout_removed=True,
        )
    raise HerdrError(
        f"{' '.join(argv[:3])} left {path} registered with git "
        f"(exit {proc.returncode}): {detail}"
    )


def main():
    parser = argparse.ArgumentParser(description="Remove one worktree (fail-closed).")
    parser.add_argument("--worktree", required=True, help="a path or a Herdr workspace_id")
    parser.add_argument("--force", action="store_true", help="override the safety refusal")
    parser.add_argument("--repo", default=os.getcwd(),
                        help="git repo for the worktree-list lookup (default: cwd)")
    args = parser.parse_args()

    if os.environ.get("HERDR_ENV") != "1":
        emit_judgment("not running inside a Herdr session (HERDR_ENV != 1)")

    try:
        path, workspace_id = resolve(args.worktree, args.repo)

        if not args.force:
            if is_dirty(path):
                emit_judgment("worktree has uncommitted changes (dirty tree)",
                              path=path, workspace_id=workspace_id)
            reason = unpushed_reason(path)
            if reason:
                emit_judgment(reason, path=path, workspace_id=workspace_id)
            if agent_live(workspace_id):
                emit_judgment("a live agent still occupies a pane in this workspace",
                              path=path, workspace_id=workspace_id)
            if workspace_id and workspace_id == os.environ.get("HERDR_WORKSPACE_ID"):
                emit_judgment("this is the caller's own active workspace",
                              path=path, workspace_id=workspace_id)

        do_remove(workspace_id, path, args.repo)
    except HerdrError as error:
        emit_error(str(error))


if __name__ == "__main__":
    main()
