#!/usr/bin/env python3
"""Fetch a tracked task's title and body, to seed a branch name and a first prompt.

A GitHub issue (a bare number) resolves through `gh` in the current repo. A Jira
key (ABC-123) resolves through the Jira REST API and needs JIRA_BASE_URL,
JIRA_EMAIL, and JIRA_API_TOKEN in the environment; without them it reports a
clear error rather than guessing. Jira's rich-text (ADF) descriptions are
flattened to plain text.

This is the deterministic half of `herdr-work-issue`. Synthesizing a slug from
the title, and deciding the branch name, is judgement and stays in SKILL.md;
this only fetches. Prints one JSON object on stdout:

    { "source": "github", "task_id": "123", "title": "...", "summary": "..." }

Standard library only, plus `gh` for GitHub.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request

# A Jira key looks like ABC-123; a bare number is a GitHub issue.
JIRA_KEY = re.compile(r"^[A-Z][A-Z0-9]+-\d+$")
GH_ISSUE = re.compile(r"^\d+$")


def die(message: str) -> "None":
    print(f"fetch-task: {message}", file=sys.stderr)
    raise SystemExit(1)


def emit(obj: dict) -> None:
    print(json.dumps(obj))


def adf_to_text(node) -> str:
    """Flatten a Jira ADF description node into plain text."""
    if node is None:
        return ""
    if isinstance(node, str):
        return node
    if node.get("type") == "text":
        return node.get("text", "")
    if node.get("type") == "hardBreak":
        return "\n"
    content = node.get("content")
    inner = "".join(adf_to_text(c) for c in content) if isinstance(content, list) else ""
    block_types = {"paragraph", "heading", "blockquote", "listItem", "codeBlock", "rule"}
    return f"{inner}\n" if node.get("type") in block_types else inner


def fetch_github(task_id: str) -> dict:
    done = subprocess.run(
        ["gh", "issue", "view", task_id, "--json", "title,body"],
        capture_output=True, text=True,
    )
    if done.returncode != 0:
        die(f"gh issue view {task_id}: {done.stderr.strip() or 'failed'}")
    data = json.loads(done.stdout)
    return {"source": "github", "task_id": task_id, "title": data.get("title", ""),
            "summary": data.get("body") or ""}


def fetch_jira(key: str) -> dict:
    base = os.environ.get("JIRA_BASE_URL")
    email = os.environ.get("JIRA_EMAIL")
    token = os.environ.get("JIRA_API_TOKEN")
    if not (base and email and token):
        die("Jira not configured. Set JIRA_BASE_URL, JIRA_EMAIL, and JIRA_API_TOKEN.")

    auth = base64.b64encode(f"{email}:{token}".encode()).decode()
    url = f"{base.rstrip('/')}/rest/api/3/issue/{key}?fields=summary,description"
    request = urllib.request.Request(url, headers={
        "Authorization": f"Basic {auth}",
        "Accept": "application/json",
    })
    try:
        with urllib.request.urlopen(request) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as exc:
        die(f"Jira {key}: HTTP {exc.code}")
    except urllib.error.URLError as exc:
        die(f"Jira {key}: {exc.reason}")

    fields = data.get("fields") or {}
    raw = fields.get("description")
    summary = raw if isinstance(raw, str) else adf_to_text(raw).strip()
    return {"source": "jira", "task_id": key, "title": fields.get("summary") or key,
            "summary": summary}


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="fetch-task",
        description="Fetch a tracked task's title and body (GitHub issue or Jira key).",
    )
    parser.add_argument("task_id", help="GitHub issue number (123) or Jira key (ABC-123)")
    args = parser.parse_args()

    task_id = args.task_id.lstrip("#").strip()
    if JIRA_KEY.match(task_id):
        emit(fetch_jira(task_id))
    elif GH_ISSUE.match(task_id):
        emit(fetch_github(task_id))
    else:
        die(f'unrecognized task id "{task_id}". Expected a GitHub number or a Jira key like ABC-123.')


if __name__ == "__main__":
    main()
