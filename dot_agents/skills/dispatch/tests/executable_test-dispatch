#!/usr/bin/env python3
"""Behavior tests for the dispatch entry point against a fake Herdr."""

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest


SKILL_DIR = Path(__file__).parents[1]
SCRIPT = SKILL_DIR / "scripts" / "dispatch"
if not SCRIPT.exists():
    SCRIPT = SKILL_DIR / "scripts" / "executable_dispatch"


FAKE_HERDR = r'''#!/usr/bin/env python3
import json
import os
import sys

args = sys.argv[1:]
with open(os.environ["FAKE_HERDR_LOG"], "a") as log:
    log.write(json.dumps(args) + "\n")

root = os.environ["FAKE_ROOT"]
if args[:2] == ["workspace", "list"]:
    result = {"workspaces": [
        {"workspace_id": "w1", "label": "repo",
         "worktree": {"checkout_path": f"{root}/repo"}},
        {"workspace_id": "w2", "label": "nested",
         "worktree": {"checkout_path": f"{root}/repo/.worktrees/feature"}},
        {"workspace_id": "w3", "label": "plain"},
    ]}
elif args[:2] == ["tab", "create"]:
    result = {"tab": {"tab_id": "w2:t2"}, "root_pane": {"pane_id": "w2:p9"}}
elif args[:2] == ["agent", "list"]:
    result = {"agents": []}
elif args[:2] in (["agent", "start"], ["agent", "prompt"], ["agent", "get"], ["pane", "close"]):
    result = {}
else:
    print(f"unexpected fake Herdr call: {args}", file=sys.stderr)
    sys.exit(2)

print(json.dumps({"result": result}))
'''


class DispatchTests(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(os.path.realpath(self.temp.name))
        (self.root / "repo" / ".worktrees" / "feature" / "src").mkdir(parents=True)
        fake_bin = self.root / "bin"
        fake_bin.mkdir()
        herdr = fake_bin / "herdr"
        herdr.write_text(FAKE_HERDR)
        herdr.chmod(0o755)
        self.log = self.root / "herdr.log"
        self.env = {
            key: value for key, value in os.environ.items()
            if not key.startswith(("HERDR_", "ORCA_"))
        }
        self.env.update({
            "FAKE_HERDR_LOG": str(self.log),
            "FAKE_ROOT": str(self.root),
            "PATH": f"{fake_bin}{os.pathsep}{self.env['PATH']}",
        })

    def herdr_env(self, **extra):
        self.env.update({"HERDR_ENV": "1", "HERDR_PANE_ID": "w9:p1",
                         "HERDR_WORKSPACE_ID": "w9", **extra})

    def dispatch(self, *args):
        return subprocess.run([sys.executable, str(SCRIPT), *args],
                              capture_output=True, text=True, env=self.env)

    def calls(self):
        if not self.log.exists():
            return []
        return [json.loads(line) for line in self.log.read_text().splitlines()]

    def call(self, *prefix):
        return next(call for call in self.calls() if call[:len(prefix)] == list(prefix))

    def test_no_workspace_tool_needs_judgment(self):
        result = self.dispatch("agent", "status", "--agent", "x")
        self.assertEqual(result.returncode, 2)
        self.assertIn("no workspace tool", json.loads(result.stdout)["reason"])
        self.assertEqual(self.calls(), [])

    def test_orca_agents_are_addressed_by_place(self):
        self.env["ORCA_PANE_KEY"] = "k"
        result = self.dispatch("agent", "status", "--agent", "explore-x")
        self.assertEqual(result.returncode, 2)
        self.assertIn("by its place", json.loads(result.stdout)["reason"])

    def test_launch_maps_place_and_report_back_to_herdr(self):
        self.herdr_env()
        result = self.dispatch("agent", "launch", "--place", "w1:p3", "--kind", "claude",
                               "--name", "explore-x", "--seed-prompt", "Look at X.",
                               "--report-back")
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(json.loads(result.stdout)["place"], "w1:p3")
        start = self.call("agent", "start")
        self.assertEqual(start[start.index("--pane") + 1], "w1:p3")
        seed = self.call("agent", "prompt")[3]
        self.assertIn("Look at X.", seed)
        self.assertIn("w9:p1", seed)

    def test_report_back_without_a_caller_pane_needs_judgment(self):
        self.herdr_env()
        del self.env["HERDR_PANE_ID"]
        result = self.dispatch("agent", "launch", "--place", "w1:p3", "--kind", "codex",
                               "--report-back")
        self.assertEqual(result.returncode, 2)
        self.assertNotIn(["agent", "start"], [call[:2] for call in self.calls()])

    def test_terminal_tab_lands_in_the_innermost_workspace_holding_cwd(self):
        self.herdr_env()
        cwd = self.root / "repo" / ".worktrees" / "feature" / "src"
        result = self.dispatch("terminal", "create", "--cwd", str(cwd), "--tab",
                               "--label", "explore-x")
        self.assertEqual(result.returncode, 0, result.stderr)
        output = json.loads(result.stdout)
        self.assertEqual(output["place"], "w2:p9")
        create = self.call("tab", "create")
        self.assertEqual(create[create.index("--workspace") + 1], "w2")
        self.assertEqual(create[create.index("--cwd") + 1], str(cwd))

    def test_terminal_outside_any_checkout_uses_the_callers_workspace(self):
        self.herdr_env()
        result = self.dispatch("terminal", "create", "--cwd", str(self.root), "--tab")
        self.assertEqual(result.returncode, 0, result.stderr)
        create = self.call("tab", "create")
        self.assertEqual(create[create.index("--workspace") + 1], "w9")

    def test_send_and_close_pass_through_to_herdr(self):
        self.herdr_env()
        self.assertEqual(self.dispatch("agent", "send", "--agent", "a", "--message", "hi",
                                       "--wait", "--timeout", "5000").returncode, 0)
        self.assertEqual(self.call("agent", "prompt"),
                         ["agent", "prompt", "a", "hi", "--wait", "--timeout", "5000"])
        self.assertEqual(self.dispatch("terminal", "close", "--place", "w2:p9").returncode, 0)
        self.assertEqual(self.call("pane", "close"), ["pane", "close", "w2:p9"])


if __name__ == "__main__":
    unittest.main()
