#!/bin/bash
set -euo pipefail

skill_dir="$(cd "$(dirname "$0")/.." && pwd)"
script="$skill_dir/scripts/dispatch.py"
[ -f "$script" ] || script="$skill_dir/scripts/executable_dispatch.py"
tmp="$(mktemp -d "${TMPDIR:-/tmp}/test-dispatch-advance.XXXXXX")"
trap 'rm -rf "$tmp"' EXIT
root="$(cd "$tmp" && pwd -P)"
origin="$root/origin.git" repo="$root/repo"
git=(git -c user.name=t -c user.email=t@t)

# A fake gh that reports each PR's head from origin's refs/pull/<n>/head, and a
# fake Herdr in which no agent or workspace is open, so every reviewer is gone.
mkdir "$tmp/bin"
cat >"$tmp/bin/gh" <<EOF
#!/bin/bash
n="\$3"
sha="\$(git -C "$origin" rev-parse "refs/pull/\$n/head")"
printf '{"number":%s,"title":"t","url":"u","author":{"login":"a"},"baseRefName":"main","headRefName":"pr-%s","headRefOid":"%s"}\n' "\$n" "\$n" "\$sha"
EOF
cat >"$tmp/bin/herdr" <<'EOF'
#!/bin/bash
case "$1 $2" in
"agent get") exit 1 ;;
"workspace list") echo '{"result":{"workspaces":[]}}' ;;
*) echo '{"result":{}}' ;;
esac
EOF
chmod +x "$tmp/bin/gh" "$tmp/bin/herdr"
export PATH="$tmp/bin:$PATH" HERDR_ENV=1

git init -q --bare -b main "$origin"
git clone -q "$origin" "$repo" 2>/dev/null
"${git[@]}" -C "$repo" commit -q --allow-empty -m base
git -C "$repo" push -q origin main
echo .herdr-dispatch.json >>"$repo/.git/info/exclude"

push_pr() { # number: add a commit to the PR's head on origin
	local sha
	sha="$(git -C "$origin" rev-parse -q --verify "refs/pull/$1/head" || git -C "$origin" rev-parse main)"
	sha="$(GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t \
		git -C "$origin" commit-tree "$sha^{tree}" -p "$sha" -m "push to $1")"
	git -C "$origin" update-ref "refs/pull/$1/head" "$sha"
}

# An active pass, set up as `prepare` and `mark` leave it, at the PR's head.
review() { # number
	local wt="$repo/.worktrees/pr-$1"
	push_pr "$1"
	(cd "$repo" && python3 "$script" prepare --pr-number "$1" >/dev/null)
	git -C "$repo" worktree add -q "$wt" "pr-$1"
	printf '{"created_by":"herdr-dispatch"}\n' >"$wt/.herdr-dispatch.json"
	python3 "$script" mark --worktree "$wt" --pr-number "$1" --head-sha "$(git -C "$wt" rev-parse HEAD)" \
		--status active --workspace-id gone --agent-name "review-$1" >/dev/null
}

failures=0
check() { # name, condition...
	if "${@:2}"; then echo "ok $1"; else
		echo "FAIL $1" >&2
		failures=$((failures + 1))
	fi
}
field() { python3 -c 'import json,sys; print(json.load(sys.stdin).get(sys.argv[1]))' "$1"; }
marked_head() { python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["github_pr_review"]["head_sha"])' "$1/.herdr-dispatch.json"; }

review 7
wt="$repo/.worktrees/pr-7"
out="$(python3 "$script" advance --worktree "$wt" --pr-number 7)"
check "advance at the current head changes nothing" [ "$(field advanced <<<"$out")" = False ]

old="$(git -C "$wt" rev-parse HEAD)"
push_pr 7
new="$(git -C "$origin" rev-parse refs/pull/7/head)"
out="$(python3 "$script" advance --worktree "$wt" --pr-number 7)"
check "advance moves the checkout to the new head" [ "$(git -C "$wt" rev-parse HEAD)" = "$new" ]
check "advance reports the head it left" [ "$(field previous_head <<<"$out")" = "$old" ]
check "advance records the new head in the marker" [ "$(marked_head "$wt")" = "$new" ]
check "a fast-forward is not reported as rewritten" [ "$(field rewritten <<<"$out")" = False ]

push_pr 7
touch "$wt/local-work"
if python3 "$script" advance --worktree "$wt" --pr-number 7 >/dev/null; then status=0; else status=$?; fi
check "advance refuses a checkout with local changes" [ "$status" = 2 ]
check "a refused advance leaves the checkout alone" [ "$(git -C "$wt" rev-parse HEAD)" = "$new" ]
rm "$wt/local-work"

# The same pass, its reviewer gone, after the head moved: prepare relaunches it
# at the new head rather than reporting it stale.
out="$(cd "$repo" && python3 "$script" prepare --pr-number 7)"
check "prepare relaunches an orphaned pass whose head moved" [ "$(field action <<<"$out")/$(field relaunched <<<"$out")" = dispatch/True ]
check "the relaunch moves the checkout to the new head" [ "$(git -C "$wt" rev-parse HEAD)" = "$(git -C "$origin" rev-parse refs/pull/7/head)" ]

# Under Orca, a reviewer is alive while its terminal, or any terminal in its
# worktree, runs an agent. The fake orca answers from FAKE_ORCA_AGENT.
cat >"$tmp/bin/orca" <<'EOF'
#!/bin/bash
case "$1 $2" in
"terminal show")
	printf '{"ok":true,"result":{"terminal":{"handle":"%s","connected":true,"agentIdentity":%s}}}\n' "$4" "${FAKE_ORCA_AGENT:-null}" ;;
"terminal list") echo '{"ok":true,"result":{"terminals":[]}}' ;;
*) echo '{"ok":false,"error":{"code":"unexpected"}}' ;;
esac
EOF
chmod +x "$tmp/bin/orca"
review 8
wt8="$repo/.worktrees/pr-8"
python3 "$script" mark --worktree "$wt8" --pr-number 8 --head-sha "$(git -C "$wt8" rev-parse HEAD)" \
	--status active --place term_8 >/dev/null
out="$(cd "$repo" && env -u HERDR_ENV ORCA_PANE_KEY=k FAKE_ORCA_AGENT='"claude"' python3 "$script" prepare --pr-number 8)"
check "under Orca, a reviewer whose terminal runs an agent keeps its pass" [ "$(field action <<<"$out")" = already_active ]
out="$(cd "$repo" && env -u HERDR_ENV ORCA_PANE_KEY=k python3 "$script" prepare --pr-number 8)"
check "under Orca, a pass whose reviewer is gone is relaunched" [ "$(field action <<<"$out")/$(field relaunched <<<"$out")" = dispatch/True ]

[ "$failures" -eq 0 ] || {
	echo "$out" >&2
	exit 1
}
echo "all tests passed"
