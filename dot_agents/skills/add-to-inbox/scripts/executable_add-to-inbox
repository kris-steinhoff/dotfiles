#!/usr/bin/env python3
"""Drop a note into the chief of staff's inbox for later triage.

Writes one markdown file (frontmatter + body) into the directory named by
CHIEF_OF_STAFF_INBOX. The chief of staff triages and clears these on its next
session; this tool only deposits, it never reads or triages.

Body comes from stdin (typically a heredoc), or from --file. On success the
written path is printed to stdout.

Exit codes:
  0  written; the path is on stdout.
  1  nothing to write (no inbox configured, or an empty note). Diagnostics on
     stderr.
  2  bad usage (unknown option / missing argument value).
"""

from __future__ import annotations

import argparse
import json
import os
import re
import secrets
import sys
from datetime import datetime
from pathlib import Path


def err(msg: str) -> None:
    print(f"add-to-inbox: {msg}", file=sys.stderr)


def slugify(text: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return slug[:50] or "note"


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="add-to-inbox",
        description="Drop a note into the chief of staff's inbox (CHIEF_OF_STAFF_INBOX).",
        add_help=True,
    )
    parser.add_argument("--title", default="", help="One-line summary. Defaults to the first line of the body.")
    parser.add_argument(
        "--from",
        dest="source",
        default=os.environ.get("CHIEF_OF_STAFF_INBOX_FROM", "an agent"),
        help='Who is dropping this (e.g. "codex on nexus"). Defaults to $CHIEF_OF_STAFF_INBOX_FROM, else "an agent".',
    )
    parser.add_argument("--resource", default="", help="A source link to preserve with the note.")
    parser.add_argument("--tag", action="append", default=[], dest="tags", help="A tag; repeatable.")
    parser.add_argument(
        "--dir",
        dest="dir",
        default=os.environ.get("CHIEF_OF_STAFF_INBOX", ""),
        help="Inbox directory; overrides CHIEF_OF_STAFF_INBOX.",
    )
    parser.add_argument(
        "--file",
        dest="file",
        default="",
        help="Read the body from this file instead of stdin ('-' also means stdin).",
    )

    # argparse exits 2 on bad usage, which matches this tool's contract.
    args = parser.parse_args()

    if not args.dir:
        err("the inbox path is not configured, so there is nowhere to drop this note.")
        err("To the user: setting CHIEF_OF_STAFF_INBOX in your environment is yours to")
        err("own. Point it at your chief-of-staff bundle's inbox/ directory.")
        err("To the agent: report this to the user and stop. Do not set, export, guess")
        err("at, or otherwise work around this variable.")
        return 1

    if args.file and args.file != "-":
        try:
            body = Path(args.file).read_text(encoding="utf-8")
        except OSError as exc:
            err(f"could not read --file {args.file}: {exc.strerror or exc}")
            return 1
    elif not sys.stdin.isatty():
        body = sys.stdin.read()
    else:
        body = ""
    body = body.rstrip("\n")

    title = args.title.strip()
    if not title:
        title = next((ln.strip() for ln in body.splitlines() if ln.strip()), "")
    if not title:
        title = "Untitled note"

    if not body and title == "Untitled note":
        err("refusing to drop an empty note (no body and no title).")
        return 1

    now = datetime.now().astimezone()
    stamp = now.strftime("%Y%m%dT%H%M%S")
    rand = secrets.token_hex(2)
    iso = now.strftime("%Y-%m-%dT%H:%M:%S%z")

    inbox = Path(args.dir)
    inbox.mkdir(parents=True, exist_ok=True)
    path = inbox / f"{stamp}-{slugify(title)}-{rand}.md"

    lines = [
        "---",
        "type: inbox",
        # json.dumps yields a YAML-safe double-quoted scalar for arbitrary input.
        f"title: {json.dumps(title, ensure_ascii=False)}",
        f"from: {json.dumps(args.source, ensure_ascii=False)}",
        f"timestamp: {iso}",
    ]
    if args.resource:
        lines.append(f"resource: {args.resource}")
    if args.tags:
        lines.append(f"tags: [{','.join(args.tags)}]")
    lines.append("---")
    lines.append("")
    lines.append(body)
    lines.append("")

    path.write_text("\n".join(lines), encoding="utf-8")
    print(path)
    return 0


if __name__ == "__main__":
    sys.exit(main())
