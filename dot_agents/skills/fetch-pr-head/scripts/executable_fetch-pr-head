#!/usr/bin/env python3
"""Fetch a PR's head commit into a local branch, so a worktree can be built on it.

A Herdr dispatch primitive, the source step that (chained with create-worktree)
puts a PR on disk. It always fetches through the pull-request head ref:

  git fetch --force origin pull/<pr_number>/head:<branch>

which works uniformly for same-repo and fork PRs. --force so a re-run converges
even when the PR head was rebased or force-pushed since the last fetch.

Part of the Herdr dispatch flow (HERDR_ENV=1), though it drives only git and
needs no Herdr socket, so it also runs standalone.

Exit codes (shared across the Herdr dispatch primitives):
  0  success. The JSON result object is printed to stdout.
  2  needs judgment. An expected situation the script cannot resolve
     mechanically (the PR does not exist, or the target branch is checked out in
     another worktree). stdout is JSON, {"status": "needs_judgment",
     "reason": ...} plus any known partial fields. The caller's cue to apply
     judgment or ask.
  1  real error (an unexpected git failure). Diagnostics go to stderr; stdout
     may be empty.

All subprocesses are invoked as argv lists, never a shell string, so branch
names cannot inject.
"""

import argparse
import json
import os
import subprocess
import sys


def emit_success(obj):
    print(json.dumps(obj))
    sys.exit(0)


def emit_judgment(reason, **partial):
    print(json.dumps({"status": "needs_judgment", "reason": reason, **partial}))
    sys.exit(2)


def emit_error(message):
    print(f"fetch-pr-head: {message}", file=sys.stderr)
    sys.exit(1)


def main():
    parser = argparse.ArgumentParser(description="Fetch a PR head into a local branch.")
    parser.add_argument("--pr-number", required=True, help="pull request number")
    parser.add_argument("--branch", help="local branch to create (default: pr-<number>)")
    parser.add_argument("--repo", default=os.getcwd(), help="git repo to operate in (default: cwd)")
    args = parser.parse_args()

    if not args.pr_number.isdigit():
        emit_judgment(f"pr-number {args.pr_number!r} is not a number")
    branch = args.branch or f"pr-{args.pr_number}"

    # --force: a re-fetch must converge even when the PR head was rebased or
    # force-pushed since the last fetch, not reject a non-fast-forward update.
    refspec = f"pull/{args.pr_number}/head:{branch}"
    proc = subprocess.run(
        ["git", "-C", args.repo, "fetch", "--force", "origin", refspec],
        capture_output=True,
        text=True,
    )
    if proc.returncode == 0:
        emit_success({"branch": branch, "pr_number": int(args.pr_number)})

    stderr = proc.stderr.strip()
    lowered = stderr.lower()
    if "checked out at" in lowered or "refusing to fetch into branch" in lowered:
        emit_judgment(
            f"branch {branch!r} is checked out in another worktree",
            branch=branch,
            pr_number=int(args.pr_number),
        )
    if "couldn't find remote ref" in lowered or "not found" in lowered:
        emit_judgment(
            f"PR {args.pr_number} not found on origin",
            pr_number=int(args.pr_number),
        )
    emit_error(f"git fetch {refspec} failed ({proc.returncode}): {stderr}")


if __name__ == "__main__":
    main()
