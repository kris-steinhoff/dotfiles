#!/usr/bin/env python3
"""Run a Ralph loop: one interactive agent, cleared and re-prompted each pass.

Two subcommands, because the loop must not run in the caller's pane. `start`
builds the topology and returns; `drive` is the loop itself and lives in a pane
of its own, where it can block for hours and still be watched.

    start   split a tab into agent + driver, start the agent, launch drive
    drive   /clear, submit the prompt, wait, repeat, until a stop condition

The interesting decisions are the stop conditions and the clear-then-prompt
handshake. Both are commented where they happen. Everything about *what* to put
in the prompt file stays in SKILL.md.

Standard library only. If a herdr command changes shape, this fails loudly with
herdr's own stderr rather than guessing.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import shlex
import subprocess
import sys
import time

DEFAULT_MAX = 10
DEFAULT_TIMEOUT_MS = 1_800_000  # 30 minutes for one iteration
CLEAR_SETTLE_MS = 15_000
DRIVER_RATIO = 0.8  # the agent gets the top 80%, the driver log the rest
SETTLED = ("idle", "done")


def die(message: str) -> "None":
    print(f"ralph-loop: {message}", file=sys.stderr)
    raise SystemExit(1)


def note(message: str) -> None:
    print(f"ralph-loop: {message}", file=sys.stderr)


def run(args: list[str], cwd: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True)


def herdr(args: list[str], *, allow_error: bool = False) -> dict:
    """Run a herdr command and return its parsed envelope.

    A result comes back as JSON on stdout. A server error comes back as JSON on
    stderr with exit status 1, so read whichever stream has content.
    """
    done = run(["herdr", *args])
    raw = done.stdout.strip() or done.stderr.strip()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        die(f"herdr {' '.join(args[:2])} returned no JSON:\n{raw or '(no output)'}")
    if "error" in payload and not allow_error:
        code = payload["error"].get("code", "unknown")
        die(f"herdr {' '.join(args[:2])} failed [{code}]: {payload['error'].get('message', '')}")
    return payload


def repo_root(cwd: str | None = None) -> str:
    done = run(["git", "rev-parse", "--show-toplevel"], cwd=cwd)
    if done.returncode != 0:
        die("not inside a git repository")
    return done.stdout.strip()


def require_herdr() -> None:
    if os.environ.get("HERDR_ENV") != "1":
        die("not running inside Herdr (HERDR_ENV is not 1)")


def agent_info(name: str) -> dict:
    payload = herdr(["agent", "get", name], allow_error=True)
    if "error" in payload:
        return {}
    return payload["result"]["agent"]


def agent_status(name: str) -> str:
    info = agent_info(name)
    return info.get("agent_status", "unknown") if info else "gone"


def agent_session(name: str) -> str | None:
    """The agent's own session identity, as Herdr reports it.

    Claude Code opens a new session on /clear, so a change here is direct
    evidence that the context was actually reset.
    """
    return agent_info(name).get("agent_session", {}).get("value")


def free_agent_name(base: str) -> str:
    """First unused name in base, base-2, base-3, ..."""
    for suffix in ["", *(f"-{n}" for n in range(2, 10))]:
        name = f"{base}{suffix}"
        payload = herdr(["agent", "get", name], allow_error=True)
        if payload.get("error", {}).get("code") == "agent_not_found":
            return name
    die(f"no free agent name near {base}; stop a finished loop first")


def wait_for_shell(pane: str, timeout_ms: int = 20_000) -> bool:
    """Poll until a pane is back at its own shell prompt.

    `agent start` refuses a pane that is not an available shell, and a pane
    created a moment ago is often still running shell startup. That race is
    intermittent, so waiting for it beats retrying after the failure.
    """
    deadline = time.monotonic() + timeout_ms / 1000
    while True:
        payload = herdr(["pane", "process-info", "--pane", pane], allow_error=True)
        info = payload.get("result", {}).get("process_info", {})
        shell = info.get("shell_pid")
        foreground = info.get("foreground_processes", [])
        if shell is not None and len(foreground) == 1 and foreground[0].get("pid") == shell:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.5)


def slug(text: str) -> str:
    cleaned = re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")
    return cleaned[:24] or "run"


def state_dir(workdir: str) -> str:
    """Create .ralph/ and make it ignore itself.

    A loop whose agent commits every pass would otherwise commit its own
    bookkeeping. A .gitignore of "*" inside the directory keeps the whole thing
    out of the index without touching the repository's own .gitignore.
    """
    path = os.path.join(workdir, ".ralph")
    os.makedirs(path, exist_ok=True)
    marker = os.path.join(path, ".gitignore")
    if not os.path.exists(marker):
        with open(marker, "w") as handle:
            handle.write("*\n")
    return path


# --------------------------------------------------------------------------
# drive: the loop
# --------------------------------------------------------------------------


def stamp() -> str:
    return datetime.datetime.now().strftime("%H:%M:%S")


def submit(name: str, text: str, timeout: int) -> dict:
    """Submit one prompt and wait for the turn to settle.

    A stall almost always means the keystrokes did not land rather than that the
    agent is thinking quietly, so resubmit once before believing it.
    """
    args = ["agent", "prompt", name, text, "--wait", "--timeout", str(timeout)]
    result = herdr(args, allow_error=True)
    if result.get("error", {}).get("code") == "agent_prompt_stalled":
        print(f"  {stamp()} submission not observed, resubmitting once")
        result = herdr(args, allow_error=True)
    return result


def clear_context(name: str) -> bool:
    """Send /clear and confirm the context actually reset.

    Deliberately not `--wait`: /clear goes from settled straight back to
    settled, with no lifecycle change for Herdr to observe, which reads as a
    stall. Waiting on the status instead is worse than useless, because the
    status is *already* the settled value the instant the keys are sent. That
    check passes before the agent has processed anything and the next prompt
    lands in the old context, which is the one failure this whole engine exists
    to avoid, and it is silent.

    So watch the session identity, which only changes once the clear is real.
    Agent kinds that do not report one fall back to settling plus a pause.
    """
    before = agent_session(name)
    herdr(["agent", "prompt", name, "/clear"], allow_error=True)
    deadline = time.monotonic() + CLEAR_SETTLE_MS / 1000
    while time.monotonic() < deadline:
        time.sleep(0.5)
        info = agent_info(name)
        if not info:
            return False
        if info.get("agent_status") == "blocked":
            return False
        if before is None:
            if info.get("agent_status") in SETTLED:
                time.sleep(2)
                return True
        elif info.get("agent_session", {}).get("value") not in (None, before):
            return True
    return False


def drive(args: argparse.Namespace) -> None:
    prompt_path = args.prompt
    ralph = args.state
    stop_file = os.path.join(ralph, "STOP")
    log_path = os.path.join(ralph, "loop.jsonl")

    print(f"ralph-loop: driving {args.agent} from {prompt_path}")
    print(f"ralph-loop: max {args.max} iterations, {args.timeout // 1000}s each")
    print(f"ralph-loop: stop early with `touch {stop_file}`")
    print()

    reason = f"reached the {args.max} iteration cap"
    completed = 0

    def record(entry: dict) -> None:
        with open(log_path, "a") as handle:
            handle.write(json.dumps(entry) + "\n")

    try:
        for i in range(1, args.max + 1):
            if os.path.exists(stop_file):
                reason = "STOP file present"
                break

            # Iteration 1 lands in a freshly started agent, so there is nothing
            # to clear and clearing would only cost a round trip.
            # A prompt sent into an unconfirmed clear would silently continue the
            # previous context, so an unconfirmed clear ends the loop.
            if i > 1 and not clear_context(args.agent):
                reason = f"/clear was not confirmed (agent is {agent_status(args.agent)})"
                break

            try:
                with open(prompt_path) as handle:
                    text = handle.read().strip()
            except OSError as exc:
                reason = f"cannot read the prompt file: {exc}"
                break
            if not text:
                reason = "the prompt file is empty"
                break

            print(f"[{i}/{args.max}] {stamp()} submitting {len(text)} chars")
            began = time.monotonic()
            result = submit(args.agent, text, args.timeout)
            elapsed = round(time.monotonic() - began, 1)

            if "error" in result:
                code = result["error"].get("code", "unknown")
                record({"iteration": i, "seconds": elapsed, "outcome": code})
                reason = f"iteration {i} ended with {code}"
                print(f"[{i}/{args.max}] {stamp()} {code} after {elapsed}s")
                break

            completed = i
            status = agent_status(args.agent)
            record({"iteration": i, "seconds": elapsed, "outcome": "ok", "status": status})
            print(f"[{i}/{args.max}] {stamp()} settled {status} after {elapsed}s")

            # blocked means Herdr recognized an approval or question UI. Nobody
            # should answer that from a loop, so hand it back.
            if status == "blocked":
                reason = f"agent is blocked after iteration {i}"
                break
            if status == "gone":
                reason = f"agent exited after iteration {i}"
                break
    except KeyboardInterrupt:
        reason = "interrupted from the driver pane"

    print()
    print(f"ralph-loop: stopped after {completed} iteration(s): {reason}")
    record({"stopped": reason, "completed": completed})


# --------------------------------------------------------------------------
# start: the topology
# --------------------------------------------------------------------------


def make_worktree(root: str, branch: str | None, prompt_stem: str) -> dict:
    if branch is None:
        branch = f"ralph/{slug(prompt_stem)}-{datetime.datetime.now():%Y%m%d-%H%M}"
    result = herdr([
        "worktree", "create",
        "--cwd", root,
        "--branch", branch,
        "--label", branch,
        "--json",
        "--no-focus",
    ])["result"]
    return {
        "workdir": result["worktree"]["path"],
        "pane": result["root_pane"]["pane_id"],
        "tab_id": result["root_pane"]["tab_id"],
        "workspace_id": result["workspace"]["workspace_id"],
        "branch": branch,
    }


def make_tab(workspace: str, root: str, label: str, focus: bool) -> dict:
    result = herdr([
        "tab", "create",
        "--workspace", workspace,
        "--cwd", root,
        "--label", label,
        "--focus" if focus else "--no-focus",
    ])["result"]
    return {
        "workdir": root,
        "pane": result["root_pane"]["pane_id"],
        "tab_id": result["tab"]["tab_id"],
        "workspace_id": workspace,
        "branch": None,
    }


def start(args: argparse.Namespace) -> None:
    workspace = os.environ.get("HERDR_WORKSPACE_ID")
    if not workspace:
        die("HERDR_WORKSPACE_ID is not set")

    prompt_path = os.path.abspath(args.prompt)
    if not os.path.isfile(prompt_path):
        die(f"no prompt file at {prompt_path}")

    agent_args = list(args.agent_args)
    if args.yolo:
        # Bypassing permission checks is the only way an unattended loop gets
        # through a turn, and a worktree is what keeps that contained.
        if not args.worktree_requested:
            die(
                "--yolo bypasses every permission check, so it requires --worktree.\n"
                "         To run it against this checkout anyway, pass the flag yourself:\n"
                "         ralph-loop start ... -- --dangerously-skip-permissions"
            )
        agent_args.append("--dangerously-skip-permissions")

    root = repo_root()
    name = free_agent_name(args.name or f"ralph-{slug(os.path.splitext(os.path.basename(prompt_path))[0])}")

    if args.worktree_requested:
        target = make_worktree(root, args.worktree, os.path.basename(prompt_path))
    else:
        target = make_tab(workspace, root, name, args.focus)

    ralph = state_dir(target["workdir"])

    def unwind(message: str) -> "None":
        # A worktree workspace is the user's branch on disk, so it stays; a tab
        # this run opened is ours to take back.
        if args.worktree_requested:
            die(f"{message}\n         The worktree workspace {target['workspace_id']} was left in place.")
        herdr(["tab", "close", target["tab_id"]], allow_error=True)
        die(f"{message}\n         The tab it opened was closed again.")

    if not wait_for_shell(target["pane"]):
        unwind(f"pane {target['pane']} never reached a shell prompt")

    # Driver below, agent above: the loop's log is a few lines, the agent's
    # transcript is not.
    driver = herdr([
        "pane", "split", target["pane"],
        "--direction", "down",
        "--ratio", str(DRIVER_RATIO),
        "--cwd", target["workdir"],
        "--no-focus",
    ])["result"]["pane"]["pane_id"]

    started = run([
        "herdr", "agent", "start", name,
        "--kind", args.kind,
        "--pane", target["pane"],
        *(["--", *agent_args] if agent_args else []),
    ])
    if started.returncode != 0:
        unwind(f"could not start {args.kind} in {target['pane']}:\n{started.stderr.strip()}")

    if not wait_for_shell(driver):
        note(f"driver pane {driver} was slow to reach a prompt; launching anyway")

    command = " ".join(shlex.quote(part) for part in [
        os.path.realpath(__file__), "drive", name,
        "--prompt", prompt_path,
        "--state", ralph,
        "--max", str(args.max),
        "--timeout", str(args.timeout),
    ])
    # pane run prints nothing on success, so read the exit status, not JSON.
    launched = run(["herdr", "pane", "run", driver, command])
    if launched.returncode != 0:
        die(f"could not launch the driver in {driver}:\n{launched.stderr.strip()}")

    # One real check that the loop began, rather than assuming it did.
    began = run(["herdr", "pane", "wait-output", driver, "--match", "ralph-loop: driving", "--timeout", "20000"])
    if began.returncode != 0:
        note(f"the driver pane {driver} produced no start line; read it before assuming the loop is running")

    note(f"{args.kind} looping as {name}, driver in {driver}")
    print(json.dumps({
        "agent": name,
        "kind": args.kind,
        "prompt": prompt_path,
        "max_iterations": args.max,
        "workdir": target["workdir"],
        "branch": target["branch"],
        "tab_id": target["tab_id"],
        "workspace_id": target["workspace_id"],
        "agent_pane": target["pane"],
        "driver_pane": driver,
        "stop_file": os.path.join(ralph, "STOP"),
        "log": os.path.join(ralph, "loop.jsonl"),
    }))


# --------------------------------------------------------------------------


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="ralph-loop",
        description="Re-prompt one cleared agent until it stops itself.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    s = sub.add_parser("start", help="build the topology and launch the loop")
    s.add_argument("--prompt", default="PROMPT.md", help="prompt file, re-read every pass (default: PROMPT.md)")
    s.add_argument("--max", type=int, default=DEFAULT_MAX, help=f"iteration cap (default: {DEFAULT_MAX})")
    s.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_MS, help="ms to allow one iteration")
    s.add_argument("--kind", default="claude", help="agent kind (default: claude)")
    s.add_argument("--name", help="agent name (default: derived from the prompt file)")
    s.add_argument("--worktree", nargs="?", const=None, default=None, metavar="BRANCH",
                   help="run in a new worktree workspace on BRANCH (default: a generated ralph/ branch)")
    s.add_argument("--yolo", action="store_true", help="pass --dangerously-skip-permissions; requires --worktree")
    s.add_argument("--focus", action="store_true", help="switch to the new tab (default: do not)")
    s.add_argument("agent_args", nargs="*", help="extra agent arguments, after --")

    d = sub.add_parser("drive", help="the loop itself; runs in its own pane")
    d.add_argument("agent")
    d.add_argument("--prompt", required=True)
    d.add_argument("--state", required=True)
    d.add_argument("--max", type=int, default=DEFAULT_MAX)
    d.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_MS)

    # argparse cannot tell `--worktree` from `--worktree BRANCH` after the fact,
    # and the difference decides whether --yolo is allowed.
    args = parser.parse_args()
    if args.command == "start":
        args.worktree_requested = "--worktree" in sys.argv

    require_herdr()
    (start if args.command == "start" else drive)(args)


if __name__ == "__main__":
    main()
