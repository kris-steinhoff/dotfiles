#!/usr/bin/env python3
"""Create a git + Herdr worktree on a branch, converging on re-run.

A Herdr dispatch primitive. It assembles the worktree deterministically and
handles name collisions itself, so no caller runs a check-then-retry loop:

  1. If a worktree already exists on the exact requested branch AND carries this
     tool's provenance marker (<path>/.herdr-dispatch.json), it is our own prior
     creation, so reuse it and return created=false.
  2. Else if a worktree already exists on that branch but is NOT ours (no marker,
     or another tool's checkout), auto-suffix (-2, -3, ...) to the next free name
     and create fresh.
  3. Else create fresh on the requested name (checking out an existing bare
     branch if one is there, so fetch-pr-head -> create-worktree chains cleanly).

With --path, the caller picks where the checkout goes (a bare-backed container
wants <container>/<branch>). A path is occupied if anything exists there or git
still has a worktree registered there. A branch collision suffixes branch and
path together (foo at <dir>/foo becomes foo-2 at <dir>/foo-2). When only the
path is occupied, only the path is suffixed and the branch is kept (pr-254 at
<dir>/pr-254-2): suffixing the branch would cut a new one from the base and
silently drop an existing branch's commits, such as a PR head fetch-pr-head
just brought in. The path is checked before herdr runs because a failed
`git worktree add` onto an occupied path still leaves its new branch behind.
Convergence stays keyed on the branch alone: our marked worktree on the branch
is reused wherever it sits, and its real path is returned, since git cannot
check the branch out a second time anyway.

With --workspace, herdr creates from that workspace instead of from --cwd
<repo> (herdr takes one or the other). The collision checks still run against
--repo, which defaults to the workspace's repo root. If --repo is also given
and is a different repo from the workspace's, that is needs-judgment rather
than checking one repo and creating in another.

`herdr worktree create` only runs from a repo's parent workspace (the one on
its primary checkout, or on a bare-backed container). From a linked-worktree
workspace (one on a linked git worktree checkout), or with --cwd on a linked
checkout even when no workspace is open for it, herdr refuses with
linked_worktree_source before touching git. The script lets herdr be the judge
rather than classifying the source itself, because a workspace's `worktree`
record can be missing (on parents as well as linked-worktree workspaces), so a
missing record says nothing either way. On that refusal it finds the repo's
open parent workspace and retries from it. The parent comes from `herdr
worktree list`'s source_workspace_id, which does not depend on the record,
falling back to a scan for a workspace whose record matches the repo_key with
is_linked_worktree false (herdr reports no source_workspace_id for --cwd on a
bare-backed container's linked checkout). No open parent is needs-judgment.

The retry never guesses where a new branch starts. Without --base, herdr
would branch from the parent checkout's HEAD rather than the caller's branch,
so a new branch needs an explicit --base, and a checkout-relative one (HEAD,
@, HEAD~1, @{u}) is refused too, since it would resolve in the parent
checkout. Both are needs-judgment. An existing branch, such as one
fetch-pr-head brought in, starts from nothing, so it needs no --base; the
marker records whatever base the caller passed, or none. A parent workspace or
primary checkout succeeds on the first call, exactly as before.

Every created worktree is stamped with a marker file so teardown can later
recognize it as dispatch-created, with no external registry. The marker is
excluded via the repo's shared .git/info/exclude (not the worktree's own
.gitignore, and not a repo-committed one), so it never makes a clean worktree
look dirty to `git status` or to inspect-worktree/remove-worktree's safety
checks.

Requires HERDR_ENV=1: it drives the `herdr` CLI.

Exit codes (shared across the Herdr dispatch primitives):
  0  success. The JSON result object is printed to stdout.
  2  needs judgment. An expected situation the script cannot resolve
     mechanically (here: not running inside Herdr, a --repo/--workspace
     mismatch, or a linked-worktree source it cannot resolve). stdout is JSON,
     {"status": "needs_judgment", "reason": ...} plus any known partial fields.
     The caller's cue to apply judgment or ask.
  1  real error (unexpected failure: subprocess crash, malformed herdr JSON).
     Diagnostics go to stderr; stdout may be empty.

All subprocesses are invoked as argv lists, never a shell string, so branch
names and labels cannot inject.
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

MARKER_NAME = ".herdr-dispatch.json"
MARKER_TAG = "herdr-dispatch"


class HerdrError(Exception):
    """A herdr/git subprocess failed or returned something unparsable. `code`
    carries herdr's own error code when it reported one."""

    def __init__(self, message, code=None):
        super().__init__(message)
        self.code = code


def run(argv):
    return subprocess.run(argv, capture_output=True, text=True)


def emit_success(obj):
    print(json.dumps(obj))
    sys.exit(0)


def emit_judgment(reason, **partial):
    print(json.dumps({"status": "needs_judgment", "reason": reason, **partial}))
    sys.exit(2)


def emit_error(message):
    print(f"create-worktree: {message}", file=sys.stderr)
    sys.exit(1)


def herdr_json(args):
    proc = run(["herdr", *args])
    if proc.returncode != 0:
        try:
            code = json.loads(proc.stderr or proc.stdout).get("error", {}).get("code")
        except (ValueError, AttributeError):
            code = None
        raise HerdrError(
            f"herdr {' '.join(args)} failed ({proc.returncode}): "
            f"{proc.stderr.strip() or proc.stdout.strip()}",
            code=code,
        )
    try:
        return json.loads(proc.stdout).get("result", {})
    except json.JSONDecodeError:
        raise HerdrError(f"herdr {' '.join(args)} returned non-JSON: {proc.stdout[:200]}")


def collect_dicts(obj, out=None):
    """Every dict node anywhere in a parsed JSON value.

    herdr's exact envelope shape is read defensively this way rather than pinned
    to one nesting, since the pieces we want (workspace_id, path, pane_id) are
    unambiguous by key even when their nesting varies."""
    if out is None:
        out = []
    if isinstance(obj, dict):
        out.append(obj)
        for value in obj.values():
            collect_dicts(value, out)
    elif isinstance(obj, list):
        for item in obj:
            collect_dicts(item, out)
    return out


def first_value(nodes, *keys):
    """First non-empty value for any of `keys`, node by node.

    herdr's own subcommands don't agree on a key name for the same concept —
    `worktree create`'s response uses "workspace_id" but `worktree list`'s
    entries use "open_workspace_id" — so callers pass every name in play."""
    for node in nodes:
        for key in keys:
            if node.get(key):
                return node[key]
    return None


def git_branch_exists(repo, name):
    proc = run(["git", "-C", repo, "branch", "--list", "--format=%(refname:short)", name])
    return name in [line.strip() for line in proc.stdout.splitlines()]


def git_worktrees(repo):
    proc = run(["git", "-C", repo, "worktree", "list", "--porcelain"])
    if proc.returncode != 0:
        raise HerdrError(f"git worktree list failed: {proc.stderr.strip()}")
    entries, current = [], {}
    for line in proc.stdout.splitlines():
        if line.startswith("worktree "):
            if current:
                entries.append(current)
            current = {"path": line[len("worktree "):]}
        elif line.startswith("branch "):
            ref = line[len("branch "):]
            current["branch"] = ref[len("refs/heads/"):] if ref.startswith("refs/heads/") else ref
    if current:
        entries.append(current)
    return entries


def worktree_path_for_branch(repo, branch):
    for entry in git_worktrees(repo):
        if entry.get("branch") == branch:
            return entry["path"]
    return None


def marker_is_ours(path):
    try:
        with open(os.path.join(path, MARKER_NAME), encoding="utf-8") as handle:
            return json.load(handle).get("created_by") == MARKER_TAG
    except (OSError, ValueError):
        return False


def ensure_marker_excluded(path):
    """Keep the marker out of `git status`, so a dispatch-created worktree never
    reads as dirty just for carrying its own provenance file.

    `.git/info/exclude` is per-clone and untracked (the right place for tooling
    housekeeping, unlike a repo's own committed .gitignore) and shared across all
    of a repo's worktrees (there is one common git dir), so this only needs to
    run once per repo, not once per worktree. Best-effort: a failure here should
    never block worktree creation."""
    try:
        proc = run(["git", "-C", path, "rev-parse", "--git-common-dir"])
        if proc.returncode != 0:
            return
        common_dir = proc.stdout.strip()
        if not os.path.isabs(common_dir):
            common_dir = os.path.join(path, common_dir)
        exclude_path = os.path.join(common_dir, "info", "exclude")
        os.makedirs(os.path.dirname(exclude_path), exist_ok=True)
        existing = ""
        if os.path.exists(exclude_path):
            with open(exclude_path, encoding="utf-8") as handle:
                existing = handle.read()
        if MARKER_NAME in existing.splitlines():
            return
        with open(exclude_path, "a", encoding="utf-8") as handle:
            if existing and not existing.endswith("\n"):
                handle.write("\n")
            handle.write(f"{MARKER_NAME}\n")
    except OSError:
        pass


def write_marker(path, branch, base):
    ensure_marker_excluded(path)
    stamp = datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    payload = {"created_by": MARKER_TAG, "created_at": stamp, "branch": branch, "base": base}
    with open(os.path.join(path, MARKER_NAME), "w", encoding="utf-8") as handle:
        json.dump(payload, handle)


def path_occupied(repo, path):
    """Anything on disk at `path`, or a worktree git still has registered there
    (its directory deleted but not yet pruned)."""
    if os.path.lexists(path):
        return True
    target = os.path.realpath(path)
    return any(os.path.realpath(entry["path"]) == target for entry in git_worktrees(repo))


def next_free(repo, base, path):
    """The first -N suffix free for the branch and, if given, for the path too,
    so a suffixed branch lands at a matching suffixed path."""
    suffix = 2
    while True:
        candidate = f"{base}-{suffix}"
        candidate_path = f"{path}-{suffix}" if path else None
        if (not git_branch_exists(repo, candidate)
                and not worktree_path_for_branch(repo, candidate)
                and not (candidate_path and path_occupied(repo, candidate_path))):
            return candidate, candidate_path
        suffix += 1


def next_free_path(repo, path):
    suffix = 2
    while path_occupied(repo, f"{path}-{suffix}"):
        suffix += 1
    return f"{path}-{suffix}"


def workspace_source(workspace_id):
    """(repo_root, repo_key) for a workspace; repo_key is its git common dir."""
    result = herdr_json(["worktree", "list", "--workspace", workspace_id])
    source = result.get("source") if isinstance(result, dict) else None
    root = source.get("repo_root") if isinstance(source, dict) else None
    if not root:
        raise HerdrError(f"workspace {workspace_id} reports no repo root")
    return root, source.get("repo_key")


def git_common_dir(repo):
    proc = run(["git", "-C", repo, "rev-parse", "--path-format=absolute", "--git-common-dir"])
    if proc.returncode != 0:
        raise HerdrError(f"{repo} is not a git repo: {proc.stderr.strip()}")
    return os.path.realpath(proc.stdout.strip())


def parent_workspace(workspace, repo):
    """(workspace_id, label) of the repo's open parent workspace, or None.

    `herdr worktree list` names it as source_workspace_id without relying on the
    workspace's `worktree` record, so that comes first. It is missing for --cwd
    on a bare-backed container's linked checkout, where only a scan of the
    workspace records finds the parent."""
    scope = ["--workspace", workspace] if workspace else ["--cwd", repo]
    result = herdr_json(["worktree", "list", *scope])
    source = result.get("source") if isinstance(result, dict) else None
    source_id = source.get("source_workspace_id") if isinstance(source, dict) else None
    if source_id and source_id != workspace:
        return source_id, None
    repo_key = git_common_dir(repo)
    result = herdr_json(["workspace", "list"])
    workspaces = result.get("workspaces") if isinstance(result, dict) else None
    for candidate in workspaces or []:
        info = candidate.get("worktree") or {}
        if (info.get("repo_key") and info.get("is_linked_worktree") is False
                and os.path.realpath(info["repo_key"]) == repo_key):
            return candidate.get("workspace_id"), candidate.get("label")
    return None


def resolve_parent(workspace, repo, branch, base):
    """The parent workspace to retry from after herdr refused a linked-worktree
    source, or needs-judgment.

    A new branch needs an explicit, checkout-independent base: with none, herdr
    branches from the source checkout's HEAD, and a HEAD- or @-relative base
    resolves there too, and from the parent neither is the caller's branch. An
    existing branch starts from nothing, so it needs no base."""
    source = (f"workspace {workspace} is a linked-worktree workspace" if workspace
              else f"{repo} is a linked worktree checkout")
    parent = parent_workspace(workspace, repo)
    parent_id = parent[0] if parent else None
    named = (f"{parent_id} ({parent[1]})" if parent and parent[1] else parent_id)
    if not git_branch_exists(repo, branch):
        where = (f"the parent workspace {named}" if parent
                 else "the repo's parent workspace, and none is open")
        if not base:
            emit_judgment(f"{source}; worktrees are created from {where}. Branch {branch} "
                          "doesn't exist yet, and without --base it would start from the parent "
                          "checkout's HEAD, not this checkout's branch, so pass --base "
                          "explicitly.", parent_workspace=parent_id)
        if base.startswith(("HEAD", "@")):
            emit_judgment(f"{source}; worktrees are created from {where}, where --base {base} "
                          "would resolve against the parent checkout, not this one. Pass an "
                          "explicit ref or commit.", parent_workspace=parent_id)
    if not parent:
        emit_judgment(f"{source}, and no parent workspace is open for its repo "
                      f"({git_common_dir(repo)}). Open one on the primary checkout, then retry.")
    return parent_id


def workspace_id_for_path(repo, target):
    result = herdr_json(["worktree", "list", "--cwd", repo])
    entries = None
    if isinstance(result, dict):
        entries = result.get("workspaces") or result.get("worktrees")
    if entries is None:
        entries = result if isinstance(result, list) else [result]
    target_real = os.path.realpath(target)
    for entry in entries:
        nodes = collect_dicts(entry)
        paths = [node["path"] for node in nodes if node.get("path")]
        if any(os.path.realpath(p) == target_real for p in paths):
            workspace_id = first_value(nodes, "workspace_id", "open_workspace_id")
            if workspace_id:
                return workspace_id
    return None


def shell_pane_id(workspace_id):
    result = herdr_json(["pane", "list", "--workspace", workspace_id])
    panes = result.get("panes") if isinstance(result, dict) else None
    if not panes:
        panes = [node for node in collect_dicts(result) if node.get("pane_id")]
    for pane in panes:
        if not pane.get("agent"):
            return pane.get("pane_id")
    return panes[0].get("pane_id") if panes else None


def create_fresh(repo, branch, base, label, workspace, path):
    args = ["worktree", "create", "--branch", branch, "--no-focus"]
    args += ["--workspace", workspace] if workspace else ["--cwd", repo]
    if path:
        args += ["--path", path]
    if label:
        args += ["--label", label]
    if base:
        args += ["--base", base]
    result = herdr_json(args)
    nodes = collect_dicts(result)
    workspace_id = first_value(nodes, "workspace_id")
    path = first_value(nodes, "path")
    if not workspace_id:
        raise HerdrError("worktree create returned no workspace id")
    if not path:
        raise HerdrError("worktree create returned no path")
    write_marker(path, branch, base)
    pane_id = shell_pane_id(workspace_id)
    return {"workspace_id": workspace_id, "path": path, "pane_id": pane_id,
            "branch": branch, "created": True}


def main():
    parser = argparse.ArgumentParser(description="Create a git + Herdr worktree on a branch.")
    parser.add_argument("--branch", required=True, help="branch to create or check out")
    parser.add_argument("--base", help="base ref for a new branch")
    parser.add_argument("--label", help="Herdr workspace label")
    parser.add_argument("--repo",
                        help="git repo to operate in (default: the --workspace's repo, else cwd)")
    parser.add_argument("--workspace", help="Herdr workspace to create from, instead of --repo")
    parser.add_argument("--path", help="explicit worktree path (default: herdr's own placement)")
    args = parser.parse_args()

    if os.environ.get("HERDR_ENV") != "1":
        emit_judgment("not running inside a Herdr session (HERDR_ENV != 1)")

    path = os.path.abspath(args.path) if args.path else None
    try:
        repo = args.repo or os.getcwd()
        if args.workspace:
            ws_root, ws_key = workspace_source(args.workspace)
            if not args.repo:
                repo = ws_root
            elif git_common_dir(repo) != os.path.realpath(ws_key or git_common_dir(ws_root)):
                emit_judgment(f"--repo {args.repo} is not the repo of workspace {args.workspace} "
                              f"({ws_root})", repo=args.repo, workspace_repo=ws_root)
        existing = worktree_path_for_branch(repo, args.branch)
        if existing and marker_is_ours(existing):
            workspace_id = workspace_id_for_path(repo, existing)
            if not workspace_id:
                raise HerdrError(f"found our worktree at {existing} but no Herdr workspace for it")
            emit_success({
                "workspace_id": workspace_id,
                "path": existing,
                "pane_id": shell_pane_id(workspace_id),
                "branch": args.branch,
                "created": False,
            })

        branch = args.branch
        if existing:
            branch, path = next_free(repo, args.branch, path)
        elif path and path_occupied(repo, path):
            path = next_free_path(repo, path)
        try:
            result = create_fresh(repo, branch, args.base, args.label, args.workspace, path)
        except HerdrError as error:
            if error.code != "linked_worktree_source":
                raise
            parent = resolve_parent(args.workspace, repo, branch, args.base)
            result = create_fresh(repo, branch, args.base, args.label, parent, path)
        emit_success(result)
    except HerdrError as error:
        emit_error(str(error))


if __name__ == "__main__":
    main()
