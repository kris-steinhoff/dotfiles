#!/usr/bin/env python3
"""Create a branch for one issue, and by default a worktree to hold it.

The check comes first and is the reason this is a script rather than a
paragraph. An agent working issues from one repository inside a worktree of a
different one sees every tracker command fail with "no issue found", which
reads like a broken tracker rather than a wrong directory. Resolving the issue
against the repository you named makes that impossible to start.

Standard library only, on purpose. A branch setup helper that needs installing
is the application this workflow replaced.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from pathlib import Path


def die(message: str) -> "None":
    print(f"issue-branch: {message}", file=sys.stderr)
    raise SystemExit(1)


def note(message: str) -> None:
    print(f"issue-branch: {message}", file=sys.stderr)


def run(args: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True)


def have(program: str) -> bool:
    from shutil import which

    return which(program) is not None


def repo_root(path: Path) -> Path:
    if not path.exists():
        die(f"--repo does not exist: {path}")
    done = run(["git", "-C", str(path), "rev-parse", "--show-toplevel"])
    if done.returncode != 0:
        die(f"not a git repository: {path}")
    return Path(done.stdout.strip())


def check_issue(root: Path, issue: str) -> None:
    """Confirm the issue resolves in this repository's tracker."""
    if (root / ".beads").is_dir() or have("bd"):
        done = run(["bd", "show", issue, "--json"], cwd=root)
        if done.returncode == 0:
            note(f"beads resolves {issue} in {root}")
            return
        if (root / ".beads").is_dir():
            die(
                f"beads in {root} does not know {issue}.\n"
                f"         Either the issue id is wrong, or this is the wrong repository.\n"
                f"         Check with: bd list --status=open  (run inside {root})"
            )

    remote = run(["git", "-C", str(root), "remote", "get-url", "origin"])
    if "github.com" in remote.stdout and have("gh"):
        done = run(["gh", "issue", "view", issue, "--json", "number"], cwd=root)
        if done.returncode == 0:
            note(f"github resolves issue {issue} in {root}")
            return
        die(
            f"github issue {issue} not found from {root}.\n"
            f"         Check with: gh issue list  (run inside {root})"
        )

    note(f"no tracker detected in {root}; skipping the issue check")


def worktree_for(root: Path, branch: str) -> Path | None:
    done = run(["git", "-C", str(root), "worktree", "list", "--porcelain"])
    current: Path | None = None
    for line in done.stdout.splitlines():
        if line.startswith("worktree "):
            current = Path(line[len("worktree ") :])
        elif line == f"branch refs/heads/{branch}":
            return current
    return None


def branch_exists(root: Path, branch: str) -> bool:
    done = run(
        ["git", "-C", str(root), "show-ref", "--verify", "--quiet", f"refs/heads/{branch}"]
    )
    return done.returncode == 0


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="issue-branch",
        description="Create a branch and worktree for one issue, after confirming the issue lives in this repo.",
    )
    parser.add_argument("--repo", required=True, type=Path, help="repository to work in")
    parser.add_argument("--issue", required=True, help="issue id, as the tracker spells it")
    parser.add_argument("--branch", help="branch name (default: issue/<issue>)")
    parser.add_argument("--base", default="HEAD", help="ref to branch from (default: HEAD)")
    parser.add_argument("--path", type=Path, help="worktree path (default: ~/.worktrees/<repo>/<issue>)")
    parser.add_argument(
        "--check", action="store_true", help="verify repo and issue match, create nothing"
    )
    parser.add_argument(
        "--no-check", action="store_true", help="skip the tracker check (rarely what you want)"
    )
    parser.add_argument(
        "--no-worktree", action="store_true", help="create the branch in place, no worktree"
    )
    args = parser.parse_args()

    root = repo_root(args.repo)
    branch = args.branch or f"issue/{args.issue}"

    if not args.no_check:
        check_issue(root, args.issue)

    if args.check:
        note("check only; nothing created")
        return

    if args.no_worktree:
        if branch_exists(root, branch):
            note(f"branch {branch} already exists; checking it out")
            done = run(["git", "-C", str(root), "checkout", branch])
        else:
            done = run(["git", "-C", str(root), "checkout", "-b", branch, args.base])
        if done.returncode != 0:
            die(done.stderr.strip() or "git checkout failed")
        note(f"on branch {branch} in {root}")
        print(root)
        return

    existing = worktree_for(root, branch)
    if existing is not None:
        note(f"worktree for {branch} already exists")
        print(existing)
        return

    path = args.path or Path.home() / ".worktrees" / root.name / args.issue
    if path.exists() and any(path.iterdir()):
        die(f"{path} exists and is not empty; pass --path to choose another")
    path.parent.mkdir(parents=True, exist_ok=True)

    add = ["git", "-C", str(root), "worktree", "add"]
    add += [str(path), branch] if branch_exists(root, branch) else ["-b", branch, str(path), args.base]
    done = run(add)
    if done.returncode != 0:
        die(done.stderr.strip() or "git worktree add failed")

    note(f"branch {branch} from {args.base}")
    print(path)


if __name__ == "__main__":
    main()
