#!/usr/bin/env python3
"""Create a Herdr worktree workspace, from a pull request or a fresh branch.

Two subcommands, because "the branch already exists on GitHub" and "make me a
new branch" are different jobs that happen to end the same way, in a worktree
with a shell pane ready for an agent:

    pr      check out an existing pull request's branch
    create  make a worktree for a branch, creating the branch if it is new

Both print the same JSON envelope (branch, path, workspace_id, pane_id, ...),
so whatever starts an agent afterwards does not care which one ran. Neither
starts an agent; that is `herdr-start-agent`'s job, and `herdr-work-task`
chains the two.

## pr

The local branch keeps the PR's own name. Fork and same-repository PRs need
different fetch refspecs, and that conditional shows up in more than one place,
which is exactly the kind of thing worth not re-deriving.

Most of the pr path is about arriving somewhere that already half exists. A PR
gets opened, looked at, closed, and opened again, so the interesting states are
"branch already checked out in a worktree", "worktree on disk but no Herdr
workspace", "workspace already open", and "local branch left behind by an
earlier cleanup". Each of those used to end in a bare error or a dead end that
the caller had to finish by hand, so each one is handled here instead:

  - already checked out  -> refresh it in place, then open or focus its workspace
  - not open in Herdr    -> `worktree open` attaches a workspace to the path
  - already open         -> `worktree open` reports already_open, and we focus it
  - stale metadata       -> prune and create fresh
  - local branch exists  -> reuse it rather than asking git to create it again
  - held by the main checkout -> exit 3, and take the branch with --vacate

Refreshing is a fetch plus `merge --ff-only`, never a reset. A dirty worktree,
local commits, or a force-push all stop the update and get reported rather than
resolved, because deciding what to do with someone's work is not this script's
job.

## create

The generic path: given a branch name and label, make a worktree for it. A
fresh branch is created from --base (or the repo HEAD); an existing local branch
is checked out as it stands. Re-running converges: an existing worktree on the
branch is opened and focused rather than recreated. The branch name and slug are
the caller's to decide (that judgement lives in `herdr-work-task`), so this
subcommand does not fetch a task or invent a name.

Teardown is deliberately not here, for either path. Removing a workspace by ID
is one typo away from removing someone else's, and this Herdr instance is
shared. SKILL.md has the two commands to run by hand.

Standard library only. If a herdr command changes shape, this fails loudly with
herdr's own stderr rather than guessing.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys


def die(message: str) -> "None":
    print(f"worktree: {message}", file=sys.stderr)
    raise SystemExit(1)


def note(message: str) -> None:
    print(f"worktree: {message}", file=sys.stderr)


def run(args: list[str], cwd: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True)


def herdr(args: list[str], *, allow_error: bool = False) -> dict:
    """A result comes back as JSON on stdout. A server error comes back as JSON
    on stderr with exit status 1, so read whichever stream has content."""
    done = run(["herdr", *args])
    raw = done.stdout.strip() or done.stderr.strip()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        die(f"herdr {' '.join(args[:2])} returned no JSON:\n{raw or '(no output)'}")
    if "error" in payload:
        if allow_error:
            return payload
        code = payload["error"].get("code", "unknown")
        die(f"herdr {' '.join(args[:2])} failed [{code}]: {payload['error'].get('message', '')}")
    return payload


def repo_root() -> str:
    done = run(["git", "rev-parse", "--show-toplevel"])
    if done.returncode != 0:
        die("not inside a git repository")
    return done.stdout.strip()


def resolve_pr(arg: str | None, cwd: str) -> dict:
    fields = "number,title,headRefName,isCrossRepository"
    target = ["gh", "pr", "view"]
    if arg:
        target.append(arg)
    done = run([*target, "--json", fields], cwd=cwd)
    if done.returncode == 0:
        return json.loads(done.stdout)

    listing = run(
        ["gh", "pr", "list", "--state", "open", "--limit", "20", "--json", "number,title,headRefName"],
        cwd=cwd,
    )
    candidates = json.loads(listing.stdout) if listing.returncode == 0 else []
    if arg:
        print(f"worktree: no such pull request: {arg}", file=sys.stderr)
    else:
        print("worktree: the current branch has no pull request", file=sys.stderr)
    if candidates:
        print("worktree: open pull requests:", file=sys.stderr)
        for c in candidates:
            print(f"  #{c['number']}  {c['headRefName']}  {c['title']}", file=sys.stderr)
    raise SystemExit(2)


def worktrees(root: str) -> list[dict]:
    """Every worktree of this repository, main one first, which is the order
    git reports them in."""
    done = run(["git", "-C", root, "worktree", "list", "--porcelain"])
    if done.returncode != 0:
        die(f"could not list worktrees:\n{done.stderr.strip()}")
    records: list[dict] = []
    current: dict = {}
    for line in done.stdout.splitlines():
        if not line.strip():
            if current:
                records.append(current)
                current = {}
            continue
        key, _, value = line.partition(" ")
        if key == "worktree":
            current = {"path": value}
        elif key == "branch":
            current["branch"] = value.removeprefix("refs/heads/")
    if current:
        records.append(current)
    return records


def default_branch(root: str) -> str:
    """What the main checkout goes back to when it gives up the PR branch.

    GitHub is asked first, since that is the branch the PR merges into. The
    remote's HEAD is the offline fallback."""
    done = run(["gh", "repo", "view", "--json", "defaultBranchRef"], cwd=root)
    if done.returncode == 0:
        try:
            name = json.loads(done.stdout)["defaultBranchRef"]["name"]
        except (json.JSONDecodeError, KeyError, TypeError):
            name = ""
        if name:
            return name
    done = run(["git", "-C", root, "symbolic-ref", "--quiet", "--short", "refs/remotes/origin/HEAD"])
    if done.returncode == 0 and done.stdout.strip():
        return done.stdout.strip().removeprefix("origin/")
    die("could not determine the default branch")


def vacate(path: str, branch: str, target: str) -> None:
    """Move the main checkout off the PR branch so a worktree can take it.

    Only tracked changes block this. Untracked files ride along harmlessly and
    are common in a checkout someone works in, so refusing on them would refuse
    almost always. Anything git itself would clobber, git refuses to switch."""
    dirty = run(["git", "-C", path, "status", "--porcelain", "--untracked-files=no"]).stdout.strip()
    if dirty:
        die(f"{path} has uncommitted changes on {branch}, commit or stash them first")
    done = run(["git", "-C", path, "switch", target])
    if done.returncode != 0:
        die(f"could not switch {path} to {target}:\n{done.stderr.strip()}")
    note(f"switched {path} from {branch} to {target}")


def local_branch_exists(root: str, branch: str) -> bool:
    done = run(["git", "-C", root, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"])
    return done.returncode == 0


def head_of(path: str) -> str:
    return run(["git", "-C", path, "rev-parse", "HEAD"]).stdout.strip()


def fetch_head_ref(pr_number: int, branch: str, fork: bool) -> list[str]:
    """A fork's branch is not on origin, so it comes through the pull ref. Both
    forms leave the fetched tip in FETCH_HEAD, which is what we merge, so the
    rest of the update needs no second conditional."""
    return ["fetch", "origin", f"pull/{pr_number}/head" if fork else branch]


def is_ancestor(path: str, older: str, newer: str) -> bool:
    return run(["git", "-C", path, "merge-base", "--is-ancestor", older, newer]).returncode == 0


def refresh(path: str, pr_number: int, branch: str, fork: bool) -> dict:
    """Fast-forward an existing worktree to the PR head. Anything that is not a
    fast-forward is reported, not resolved.

    The decision is made by ancestry rather than by whether the merge succeeds,
    because `merge --ff-only` also succeeds when the fetched tip is already
    behind HEAD, which would report a worktree holding unpushed commits as up to
    date."""
    dirty = run(["git", "-C", path, "status", "--porcelain"]).stdout.strip()
    if dirty:
        return {"status": "skipped-dirty", "detail": "uncommitted changes, left alone"}

    fetch = run(["git", "-C", path, *fetch_head_ref(pr_number, branch, fork)])
    if fetch.returncode != 0:
        lines = fetch.stderr.strip().splitlines()
        return {"status": "fetch-failed", "detail": lines[-1] if lines else "git said nothing"}

    head = head_of(path)
    fetched = run(["git", "-C", path, "rev-parse", "FETCH_HEAD"]).stdout.strip()
    if not fetched:
        return {"status": "fetch-failed", "detail": "FETCH_HEAD did not resolve"}
    if fetched == head:
        return {"status": "up-to-date"}
    if is_ancestor(path, fetched, head):
        return {"status": "ahead", "detail": "local commits not on the PR head yet"}
    if not is_ancestor(path, head, fetched):
        return {"status": "diverged", "detail": "not a fast-forward, resolve by hand"}

    merge = run(["git", "-C", path, "merge", "--ff-only", "FETCH_HEAD"])
    if merge.returncode != 0:
        lines = merge.stderr.strip().splitlines()
        return {"status": "merge-failed", "detail": lines[-1] if lines else "git said nothing"}
    count = run(["git", "-C", path, "rev-list", "--count", f"{head}..{fetched}"]).stdout.strip()
    return {"status": "fast-forwarded", "commits": int(count or 0)}


def open_workspace(root: str, path: str, focus: bool) -> dict:
    """Attach a Herdr workspace to a worktree that already exists on disk.

    Idempotent by design: an already-open worktree comes back with
    already_open true and the workspace that has it, so this covers both "no
    workspace yet" and "the user already has it open". The explicit focus is
    belt and braces for the second case. No --label, since a workspace the user
    renamed should keep its name."""
    result = herdr(["worktree", "open", "--cwd", root, "--path", path, "--json",
                    "--focus" if focus else "--no-focus"])["result"]
    if result.get("already_open") and focus:
        herdr(["workspace", "focus", result["workspace"]["workspace_id"]], allow_error=True)
    return result


def resolve_existing(root: str, branch: str) -> tuple[list[dict], str, dict | None]:
    """The worktree bookkeeping shared by both subcommands.

    Returns the worktree listing, the main checkout's path, and the record for
    a worktree already holding this branch (or None). Stale metadata for a
    deleted directory is pruned before answering, since git still counts it as
    holding the branch and would otherwise block a create with a confusing
    message."""
    listing = worktrees(root)
    main_checkout = listing[0]["path"] if listing else root
    already = next((w for w in listing if w.get("branch") == branch), None)
    if already is not None and not os.path.isdir(already["path"]):
        note(f"pruning stale worktree metadata for {already['path']}")
        run(["git", "-C", root, "worktree", "prune"])
        already = None
    return listing, main_checkout, already


def cmd_pr(args: argparse.Namespace) -> None:
    focus = not args.no_focus
    root = repo_root()
    pr = resolve_pr(args.pr, root)
    number = pr["number"]
    branch = pr["headRefName"]
    fork = pr["isCrossRepository"]

    _, main_checkout, already = resolve_existing(root, branch)

    # git allows one checkout per branch, so a worktree cannot take the branch
    # while the main checkout holds it. That checkout is where someone works,
    # and moving it is their call, not this script's, so ask by exiting 3.
    if already is not None and os.path.realpath(already["path"]) == os.path.realpath(main_checkout):
        if not args.vacate:
            target = default_branch(root)
            note(f"{branch} is checked out in the main checkout at {main_checkout}")
            note("git allows one checkout per branch, so the worktree cannot have it yet")
            note(f"ask whether to switch that checkout to {target}, then re-run with --vacate")
            raise SystemExit(3)
        vacate(main_checkout, branch, default_branch(root))
        already = None

    if already is not None:
        path = already["path"]
        if args.path and os.path.realpath(args.path) != os.path.realpath(path):
            note(f"ignoring --path, {branch} is already checked out at {path}")
        update = None if args.no_update else refresh(path, number, branch, fork)

        result = open_workspace(root, path, focus)
        workspace_id = result["workspace"]["workspace_id"]
        pane_id = result["root_pane"]["pane_id"]
        already_open = bool(result.get("already_open"))
        note(f"#{number} on {branch} reused at {path}"
             f"{' (workspace already open)' if already_open else ''}")

        print(json.dumps({
            "pr": number,
            "title": pr["title"],
            "branch": branch,
            "fork": fork,
            "path": path,
            "workspace_id": workspace_id,
            "pane_id": pane_id,
            "reused": True,
            "already_open": already_open,
            "update": update,
        }))
        return

    # Nothing checked out. Fetch, then let Herdr make the worktree.
    existing_branch = local_branch_exists(root, branch)
    if existing_branch:
        # A leftover from an earlier checkout. Move it forward if that is a
        # fast-forward, and leave it alone if it is not, since it may hold work.
        # Fetching into a branch is allowed precisely because nothing has it
        # checked out.
        advance = run(["git", "-C", root, "fetch", "origin",
                       f"pull/{number}/head:{branch}" if fork else f"{branch}:{branch}"])
        if advance.returncode != 0:
            note(f"local branch {branch} already exists and does not fast-forward, using it as is")
            run(["git", "-C", root, *fetch_head_ref(number, branch, fork)])
    else:
        done = run(["git", "-C", root, *fetch_head_ref(number, branch, fork)])
        if done.returncode != 0:
            die(f"could not fetch {branch}:\n{done.stderr.strip()}")

    create = [
        "worktree", "create",
        "--cwd", root,
        "--branch", branch,
        "--label", branch,
        "--json",
        "--focus" if focus else "--no-focus",
    ]
    # --base names the ref to branch from, so it is only right when the branch
    # is being created. An existing local branch is checked out as it stands.
    if not fork and not existing_branch:
        create += ["--base", f"origin/{branch}"]
    if args.path:
        create += ["--path", args.path]

    result = herdr(create)["result"]

    note(f"#{number} on {branch}"
         f"{' (fork, no upstream)' if fork else ''}"
         f"{' (reused existing local branch)' if existing_branch else ''}")
    print(json.dumps({
        "pr": number,
        "title": pr["title"],
        "branch": branch,
        "fork": fork,
        "path": result["worktree"]["path"],
        "workspace_id": result["workspace"]["workspace_id"],
        "pane_id": result["root_pane"]["pane_id"],
        "reused": False,
        "already_open": False,
        "update": None,
    }))


def cmd_create(args: argparse.Namespace) -> None:
    focus = not args.no_focus
    branch = args.branch
    label = args.label or branch
    root = repo_root()

    _, main_checkout, already = resolve_existing(root, branch)

    # The branch is held by the main checkout. Unlike the pr path there is no
    # --vacate here: a fresh branch nobody asked to move should just be reported.
    if already is not None and os.path.realpath(already["path"]) == os.path.realpath(main_checkout):
        note(f"{branch} is checked out in the main checkout at {main_checkout}")
        note("git allows one checkout per branch, so a worktree cannot have it")
        note("check out a different branch there, or pick another branch name")
        raise SystemExit(3)

    # Re-running converges: an existing worktree on the branch is opened and
    # focused rather than recreated. This is what makes starting the same issue
    # twice land in the same place.
    if already is not None:
        path = already["path"]
        if args.path and os.path.realpath(args.path) != os.path.realpath(path):
            note(f"ignoring --path, {branch} is already checked out at {path}")
        result = open_workspace(root, path, focus)
        already_open = bool(result.get("already_open"))
        note(f"{branch} reused at {path}{' (workspace already open)' if already_open else ''}")
        print(json.dumps({
            "branch": branch,
            "label": label,
            "path": path,
            "workspace_id": result["workspace"]["workspace_id"],
            "pane_id": result["root_pane"]["pane_id"],
            "reused": True,
            "already_open": already_open,
        }))
        return

    create = [
        "worktree", "create",
        "--cwd", root,
        "--branch", branch,
        "--label", label,
        "--json",
        "--focus" if focus else "--no-focus",
    ]
    # --base names the ref the new branch starts from, so it is only right when
    # the branch is being created. An existing local branch (a leftover from an
    # earlier run) is checked out as it stands.
    if not local_branch_exists(root, branch):
        if args.base:
            create += ["--base", args.base]
    elif args.base:
        note(f"ignoring --base, local branch {branch} already exists and is checked out as is")
    if args.path:
        create += ["--path", args.path]

    result = herdr(create)["result"]

    note(f"created {branch}")
    print(json.dumps({
        "branch": branch,
        "label": label,
        "path": result["worktree"]["path"],
        "workspace_id": result["workspace"]["workspace_id"],
        "pane_id": result["root_pane"]["pane_id"],
        "reused": False,
        "already_open": False,
    }))


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="worktree",
        description="Create a Herdr worktree workspace, from a pull request or a fresh branch.",
    )
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("pr", help="check out an existing pull request's branch")
    p.add_argument("pr", nargs="?", help="PR number or URL (default: the current branch's PR)")
    p.add_argument("--path", help="worktree path (default: Herdr's, under ~/.herdr/worktrees/)")
    p.add_argument("--no-focus", action="store_true", help="leave the user where they are")
    p.add_argument("--no-update", action="store_true",
                   help="do not fast-forward a worktree that already exists")
    p.add_argument("--vacate", action="store_true",
                   help="if the main checkout holds the branch, switch it to the "
                        "default branch and take the branch for the worktree")

    c = sub.add_parser("create", help="make a worktree for a branch, creating it if new")
    c.add_argument("--branch", required=True, help="branch name (created from --base if it does not exist)")
    c.add_argument("--label", help="workspace label (default: the branch name)")
    c.add_argument("--base", help="ref the new branch starts from (default: the repo HEAD)")
    c.add_argument("--path", help="worktree path (default: Herdr's, under ~/.herdr/worktrees/)")
    c.add_argument("--no-focus", action="store_true", help="leave the user where they are")

    args = parser.parse_args()

    if os.environ.get("HERDR_ENV") != "1":
        die("not running inside Herdr (HERDR_ENV is not 1)")

    (cmd_pr if args.command == "pr" else cmd_create)(args)


if __name__ == "__main__":
    main()
