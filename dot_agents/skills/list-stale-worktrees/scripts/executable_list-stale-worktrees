#!/usr/bin/env python3
"""Enumerate the repo's worktrees with status and staleness. Read-only, advisory.

A Herdr dispatch teardown primitive. It lists every worktree in the repo, reports
each one's state, and flags the stale ones. It removes nothing — the advisory
counterpart to a reap, surfacing worktrees we did not create (hand-made, or from
other tools) so a human can decide.

Each record is inspect-worktree-shaped plus `ours` and `stale`:

  {path, branch, ours, dirty, ahead, behind, pr_state, agent_live,
   idle_minutes, prunable, stale}

`stale` is true when the worktree has been idle at least `--stale-after` minutes
(default 1440 = 24h) and has no live agent. The primary checkout (the entry whose
path is the repo root) is skipped — it is never a teardown candidate.

The per-worktree logic duplicates inspect-worktree on purpose: the primitives are
flat atoms that don't call each other (see the PRD's Composition and ownership).
One worktree's degraded per-entry data (e.g. a flaky `gh` call) never fails the
whole run; only a top-level failure (the worktree enumeration itself) does.

It enumerates via `herdr worktree list` when Herdr is available (needed for the
live-agent check), else falls back to `git worktree list` and the agent fields
degrade — so it also runs standalone.

Exit codes (shared across the Herdr dispatch primitives):
  0  success. The JSON list is printed to stdout.
  1  real error (the worktree enumeration failed). Diagnostics go to stderr.

All subprocesses are invoked as argv lists, never a shell string.
"""

import argparse
import json
import os
import subprocess
import sys
from datetime import datetime, timezone

MARKER_NAME = ".herdr-dispatch.json"
MARKER_TAG = "herdr-dispatch"
DEFAULT_STALE_AFTER = 1440  # minutes (24h)


class HerdrError(Exception):
    """A herdr subprocess failed or returned something unparsable."""


def run(argv, cwd=None):
    return subprocess.run(argv, capture_output=True, text=True, cwd=cwd)


def emit_success(obj):
    print(json.dumps(obj))
    sys.exit(0)


def emit_error(message):
    print(f"list-stale-worktrees: {message}", file=sys.stderr)
    sys.exit(1)


def herdr_available():
    return os.environ.get("HERDR_ENV") == "1"


def herdr_json(args):
    proc = run(["herdr", *args])
    if proc.returncode != 0:
        raise HerdrError(
            f"herdr {' '.join(args)} failed ({proc.returncode}): "
            f"{proc.stderr.strip() or proc.stdout.strip()}"
        )
    try:
        return json.loads(proc.stdout).get("result", {})
    except json.JSONDecodeError:
        raise HerdrError(f"herdr {' '.join(args)} returned non-JSON: {proc.stdout[:200]}")


def collect_dicts(obj, out=None):
    """Every dict node anywhere in a parsed JSON value, read defensively (herdr's
    subcommands don't agree on field placement or naming)."""
    if out is None:
        out = []
    if isinstance(obj, dict):
        out.append(obj)
        for value in obj.values():
            collect_dicts(value, out)
    elif isinstance(obj, list):
        for item in obj:
            collect_dicts(item, out)
    return out


def first_value(nodes, *keys):
    for node in nodes:
        for key in keys:
            if node.get(key):
                return node[key]
    return None


# --- enumeration ------------------------------------------------------------

def enumerate_worktrees(repo):
    """[(path, open_workspace_id), ...] for every worktree in the repo.

    Prefer herdr (it carries open_workspace_id, needed for the live-agent
    check); fall back to git so the tool runs standalone."""
    if herdr_available():
        try:
            result = herdr_json(["worktree", "list", "--cwd", repo])
            entries = None
            if isinstance(result, dict):
                entries = result.get("worktrees") or result.get("workspaces")
            if entries is None:
                entries = result if isinstance(result, list) else [result]
            out = []
            for entry in entries:
                if not isinstance(entry, dict):
                    continue
                nodes = collect_dicts(entry)
                path = first_value(nodes, "path")
                workspace_id = first_value(nodes, "open_workspace_id", "workspace_id")
                if path:
                    out.append((path, workspace_id))
            if out:
                return out
        except HerdrError:
            pass  # fall through to git enumeration
    proc = run(["git", "-C", repo, "worktree", "list", "--porcelain"])
    if proc.returncode != 0:
        raise HerdrError(f"git worktree list failed: {proc.stderr.strip()}")
    return [(line[len("worktree "):], None)
            for line in proc.stdout.splitlines() if line.startswith("worktree ")]


def repo_root(repo):
    code, out, _ = git_out(repo, "rev-parse", "--show-toplevel")
    return os.path.realpath(out) if code == 0 and out else os.path.realpath(repo)


# --- git / gh fields (duplicated from inspect-worktree, by design) ----------

def git_out(path, *args):
    proc = run(["git", "-C", path, *args])
    return proc.returncode, proc.stdout.strip(), proc.stderr.strip()


def read_marker(path):
    try:
        with open(os.path.join(path, MARKER_NAME), encoding="utf-8") as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return {}


def branch_name(path):
    code, out, _ = git_out(path, "rev-parse", "--abbrev-ref", "HEAD")
    return out if code == 0 else None


def is_dirty(path):
    code, out, _ = git_out(path, "status", "--porcelain")
    return bool(out) if code == 0 else False


def upstream_ref(path):
    code, out, _ = git_out(path, "rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{upstream}")
    return out if code == 0 and out else None


def ref_exists(path, ref):
    code, _, _ = git_out(path, "rev-parse", "--verify", "--quiet", ref)
    return code == 0


def count_ahead_behind(path, left_ref, right_ref):
    code, out, _ = git_out(path, "rev-list", "--left-right", "--count",
                           f"{left_ref}...{right_ref}")
    if code != 0 or len(out.split()) != 2:
        return None, None
    try:
        parts = out.split()
        return int(parts[0]), int(parts[1])
    except ValueError:
        return None, None


def ahead_behind(path, marker_base):
    upstream = upstream_ref(path)
    if upstream:
        behind, ahead = count_ahead_behind(path, upstream, "HEAD")
        return ahead, behind
    if marker_base:
        base_ref = f"origin/{marker_base}"
        if ref_exists(path, base_ref):
            behind, ahead = count_ahead_behind(path, base_ref, "HEAD")
            return ahead, behind
    return None, None


def pr_state(path, branch):
    proc = run(["gh", "pr", "view", branch, "--json", "state,number"], cwd=path)
    if proc.returncode == 0:
        try:
            data = json.loads(proc.stdout)
        except json.JSONDecodeError:
            return "none"
        state = (data.get("state") or "").upper()
        return {"OPEN": "open", "MERGED": "merged", "CLOSED": "closed"}.get(state, "none")
    code, configured_upstream, _ = git_out(
        path, "for-each-ref", "--format=%(upstream)", f"refs/heads/{branch}")
    if code == 0 and configured_upstream and not ref_exists(path, configured_upstream):
        return "branch-gone"
    return "none"


def pane_ids_in_workspace(workspace_id):
    result = herdr_json(["pane", "list", "--workspace", workspace_id])
    panes = result.get("panes") if isinstance(result, dict) else None
    if not panes:
        panes = [node for node in collect_dicts(result) if node.get("pane_id")]
    return {pane.get("pane_id") for pane in panes if pane.get("pane_id")}


def agent_live(workspace_id):
    if not (herdr_available() and workspace_id):
        return False, None
    try:
        pane_ids = pane_ids_in_workspace(workspace_id)
        if not pane_ids:
            return False, None
        result = herdr_json(["agent", "list"])
        agents = result.get("agents") if isinstance(result, dict) else result
        if not isinstance(agents, list):
            return False, None
        for agent in agents:
            if not isinstance(agent, dict):
                continue
            if any(node.get("pane_id") in pane_ids for node in collect_dicts(agent)):
                return True, agent
        return False, None
    except HerdrError:
        return False, None


def parse_timestamp(value):
    if isinstance(value, (int, float)):
        try:
            return datetime.fromtimestamp(value, tz=timezone.utc)
        except (OverflowError, OSError, ValueError):
            return None
    if isinstance(value, str) and value.strip():
        text = value.strip()
        if text.endswith("Z"):
            text = text[:-1] + "+00:00"
        try:
            parsed = datetime.fromisoformat(text)
        except ValueError:
            try:
                return datetime.fromtimestamp(float(value), tz=timezone.utc)
            except (ValueError, OverflowError, OSError):
                return None
        if parsed.tzinfo is None:
            parsed = parsed.replace(tzinfo=timezone.utc)
        return parsed
    return None


AGENT_TIME_KEYS = ("idle_since", "last_active_at", "updated_at", "state_changed_at")


def minutes_since(moment):
    return round((datetime.now(timezone.utc) - moment).total_seconds() / 60)


def idle_minutes(path, agent):
    if agent:
        for node in collect_dicts(agent):
            for key in AGENT_TIME_KEYS:
                moment = parse_timestamp(node.get(key)) if node.get(key) is not None else None
                if moment:
                    return minutes_since(moment)
    code, out, _ = git_out(path, "log", "-1", "--format=%ct", "HEAD")
    if code == 0 and out:
        moment = parse_timestamp(out)
        if moment:
            return minutes_since(moment)
    return None


def inspect(path, workspace_id, stale_after):
    marker = read_marker(path)
    ours = marker.get("created_by") == MARKER_TAG
    branch = branch_name(path)
    dirty = is_dirty(path)
    ahead, behind = ahead_behind(path, marker.get("base"))
    state = pr_state(path, branch) if branch and branch != "HEAD" else "none"
    live, agent = agent_live(workspace_id)
    idle = idle_minutes(path, agent)
    prunable = (not dirty) and (not live) and state in {"merged", "closed", "branch-gone"}
    stale = idle is not None and idle >= stale_after and not live
    return {
        "path": path,
        "branch": branch,
        "ours": ours,
        "dirty": dirty,
        "ahead": ahead,
        "behind": behind,
        "pr_state": state,
        "agent_live": live,
        "idle_minutes": idle,
        "prunable": prunable,
        "stale": stale,
    }


def degraded_record(path):
    """A minimal record for a worktree whose inspection threw, so one bad entry
    never fails the whole advisory run."""
    return {
        "path": path,
        "branch": None,
        "ours": False,
        "dirty": False,
        "ahead": None,
        "behind": None,
        "pr_state": "none",
        "agent_live": False,
        "idle_minutes": None,
        "prunable": False,
        "stale": False,
    }


def main():
    parser = argparse.ArgumentParser(
        description="List the repo's worktrees with status and staleness (read-only).")
    parser.add_argument("--repo", default=os.getcwd(), help="git repo to enumerate (default: cwd)")
    parser.add_argument("--stale-after", type=int, default=DEFAULT_STALE_AFTER,
                        help="idle-minutes threshold for the stale flag (default: 1440)")
    args = parser.parse_args()

    try:
        entries = enumerate_worktrees(args.repo)
    except HerdrError as error:
        emit_error(str(error))

    root = repo_root(args.repo)
    records = []
    for path, workspace_id in entries:
        if os.path.realpath(path) == root:
            continue  # the primary checkout, never a teardown candidate
        try:
            records.append(inspect(path, workspace_id, args.stale_after))
        except Exception:  # noqa: BLE001 — one bad entry must not fail the run
            records.append(degraded_record(path))

    emit_success(records)


if __name__ == "__main__":
    main()
