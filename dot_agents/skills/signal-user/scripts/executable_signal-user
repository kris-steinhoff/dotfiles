#!/bin/bash
# Show the user why this agent stopped, as a signal on its Herdr workspace:
#
#   🛑  ask    the agent is waiting on the user (an answer, a decision)
#   ✓  ready  the agent finished something for the user to look at (a PR, a
#              draft, a preview), but nothing is blocked on them
#   …  wait   the agent is waiting on something else (a build, a deploy, a
#              review, another agent), so the user can look away
#
# The signal is a pair of workspace metadata tokens: `signal`, the text the
# sidebar shows (wired up in ~/.config/herdr/config.toml), and `signal_pane`,
# the pane that raised it. The two kinds end differently, so they clear
# differently:
#
# - A 🛑 or ✓ ends when the user replies. The signal-user Herdr plugin clears
#   it when the raising pane's agent starts working again.
# - A `…` ends when the thing waited on finishes, which can be several turns
#   later; the user may chat with the agent meanwhile. So the plugin leaves it
#   alone. `wait <reason> -- <command>` ties it to a command instead: it raises
#   the `…`, runs the command, and clears the `…` when the command exits, however
#   it exits. A wait with no command behind it is cleared with `clear`.
#
# The plugin also clears either kind when the raising pane closes, and a
# 24-hour TTL (the longest Herdr allows) backs everything up.
#
# A workspace shows one signal. A signal never replaces another agent's more
# urgent one (🛑 over ✓ over `…`), because hiding a request for the user behind
# something that asks less of them is the overwrite that costs something. An
# agent's own signal is always replaced; its newest one is its current state.
#
# Outside a Herdr pane this signals nothing, but a wrapped command still runs,
# so an agent can follow its instructions without checking where it is.
#
# Exit codes:
#   ask, wait, clear: 0 done or skipped, with one JSON line on stdout; 1 failed,
#     also with one JSON line, whose status says why:
#       herdr_denied       the Herdr socket was refused, as a sandbox does; the
#                          same command run with local-socket permission works
#       herdr_unavailable  Herdr could not answer (server down, an error code,
#                          output that isn't JSON)
#       unresolved         Herdr answered, but no single pane is this agent
#       too_long           the reason would not fit the sidebar line
#     2 bad usage.
#   wait -- <command>: the command's own exit code. Its stdout is left to the
#     command; this script's JSON line goes to stderr. If the signal fails, the
#     command does not run, so retrying the same line runs it once.
set -euo pipefail

ASK="🛑"
READY="✓"
WAIT="…"
TTL_MS=86400000

# The sidebar gives the signal line 30 columns at its widest (Herdr's
# sidebar_max_width of 36, less the row's indent and margin). The glyph and a
# space come out of that, and 🛑 is an emoji two columns wide, so an ask's
# reason gets one column fewer than the others. Herdr cuts a longer line short
# with "…", so a reason over the limit is refused rather than shown cut off.
SIGNAL_COLUMNS=30

usage() {
	cat <<'EOF'
Usage: signal-user ask [<reason>]                 🛑 waiting on the user
       signal-user ready [<reason>]               ✓ finished, for the user to look at
       signal-user wait [<reason>] -- <command>   … while <command> runs
       signal-user wait [<reason>]                … until `clear`
       signal-user clear                          take this agent's signal down
EOF
}

case "${1:-}" in
ask | hand | set) cmd=ask && shift ;; # `hand` and `set` are earlier names for `ask`
ready | wait | clear) cmd="$1" && shift ;;
-h | --help) usage && exit 0 ;;
*) usage >&2 && exit 2 ;;
esac

# Split `wait <reason words> -- <command...>`.
reason_words=()
command=()
while [ $# -gt 0 ]; do
	if [ "$1" = "--" ]; then
		shift
		command=("$@")
		break
	fi
	reason_words+=("$1")
	shift
done
reason="${reason_words[*]:-}"
if [ "$cmd" != wait ] && [ ${#command[@]} -gt 0 ]; then
	usage >&2 && exit 2
fi

report() { # report <json>: stdout, or stderr when the command owns stdout
	if [ ${#command[@]} -gt 0 ]; then
		printf '%s\n' "$1" >&2
	else
		printf '%s\n' "$1"
	fi
}

if [ "${HERDR_ENV:-}" != 1 ] || [ -z "${HERDR_PANE_ID:-}" ]; then
	report '{"status":"skipped","reason":"not running in a Herdr pane"}'
	[ ${#command[@]} -eq 0 ] || exec "${command[@]}"
	exit 0
fi

HERDR="${HERDR_BIN_PATH:-herdr}"
pane="$HERDR_PANE_ID"

fail() { # fail <json>: report a failure and stop, before any wrapped command runs
	report "$1"
	exit 1
}

if [ "$cmd" != clear ]; then
	glyph_width=1
	[ "$cmd" != ask ] || glyph_width=2
	limit=$((SIGNAL_COLUMNS - glyph_width - 1))
	length="$(jq -rn --arg r "$reason" '$r | length')"
	if [ "$length" -gt "$limit" ]; then
		fail "$(jq -nc --arg r "$reason" --argjson n "$length" --argjson l "$limit" '
			{status: "too_long", reason: $r, length: $n, limit: $l,
			 hint: "the sidebar would cut this reason off; rerun with one of at most \($l) characters"}')"
	fi
fi

# herdr_q <args...>: run a Herdr query, leaving its JSON (or nothing, for a
# write) in $herdr_out. On failure it returns nonzero with Herdr's own message
# in $herdr_detail and, when the server answered with one, its error code in
# $herdr_code.
herdr_q() {
	local errf rc=0
	errf="$(mktemp "${TMPDIR:-/tmp}/signal-user.XXXXXX" 2>/dev/null)" || errf=""
	herdr_out="$("$HERDR" "$@" 2>"${errf:-/dev/null}")" || rc=$?
	herdr_detail=""
	if [ -n "$errf" ]; then
		herdr_detail="$(cat "$errf")"
		rm -f "$errf"
	fi
	if [ "$rc" = 0 ] && [ -n "$herdr_out" ] && ! jq -e . >/dev/null 2>&1 <<<"$herdr_out"; then
		rc=1
		herdr_detail="unexpected output: $herdr_out"
	fi
	herdr_code="$(jq -r '.error.code // empty' 2>/dev/null <<<"$herdr_detail")" || herdr_code=""
	return "$rc"
}

# herdr_failed <query>: report why Herdr could not answer, and stop. A refused
# socket is told apart from every other failure because its fix is the
# caller's (rerun with permission), not anything about panes or Herdr.
herdr_failed() {
	local status=herdr_unavailable hint=""
	if grep -Eqi 'PermissionDenied|permission denied|operation not permitted' <<<"$herdr_detail"; then
		status=herdr_denied
		hint="a sandbox refused the Herdr socket; if your harness can grant permission to reach it, rerun this same command with that permission before looking into pane state, and otherwise tell the user"
	fi
	fail "$(jq -nc --arg s "$status" --arg q "$1" --arg d "$herdr_detail" --arg c "$herdr_code" \
		--arg sock "${HERDR_SOCKET_PATH:-}" --arg h "$hint" '
		{status: $s, query: $q, detail: $d}
		+ (if $c != "" then {error_code: $c} else {} end)
		+ (if $sock != "" then {socket: $sock} else {} end)
		+ (if $h != "" then {hint: $h} else {} end)')"
}

# unresolved <reason> [<candidates>]: Herdr answered, but not with one pane.
unresolved() {
	fail "$(jq -nc --arg p "$HERDR_PANE_ID" --arg r "$1" --argjson c "${2:-[]}" '
		{status: "unresolved", inherited_pane: $p, reason: $r}
		+ (if ($c | length) > 0 then {candidates: $c} else {} end)')"
}

# Ask Herdr for the canonical live pane ID rather than retaining the inherited
# ID, which becomes an alias after a pane moves.
#
# Under Codex the inherited ID can belong to another pane entirely. An
# interactive Codex runs its tool commands in a shared app-server daemon, which
# carries the environment of whichever pane first started it, so every session
# on that daemon inherits that one pane (or a pane since closed). The inherited
# pane is trusted only when it hosts a Codex agent itself; otherwise the agent
# is found by its working directory: the Codex pane whose cwd most closely
# contains this command's. More than one there fails rather than guessing,
# since a signal under the wrong pane is one its owner cannot clear.
#
# Only Herdr's own "no such pane" is an answer here. Any other failure means
# Herdr was not asked at all, so it is reported as that, never as ambiguity.
pane_info=""
if herdr_q pane get "$pane"; then
	pane_info="$herdr_out"
elif [ "$herdr_code" != pane_not_found ]; then
	herdr_failed "pane get"
fi
live_pane="$(jq -r '.result.pane.pane_id // empty' <<<"$pane_info")"
ws="$(jq -r '.result.pane.workspace_id // empty' <<<"$pane_info")"
live_agent="$(jq -r '.result.pane.agent // empty' <<<"$pane_info")"
if [ -n "${CODEX_THREAD_ID:-${CODEX_SESSION_ID:-}}" ] && [ "$live_agent" != codex ]; then
	herdr_q agent list || herdr_failed "agent list"
	cwd="$(pwd -P)"
	matches="$(jq -c --arg cwd "$cwd" '
		[.result.agents[]? | select(.agent == "codex" and (.cwd // "") != "")
			| select(.cwd as $c | $cwd == $c or ($cwd | startswith($c + "/")))]
		| (map(.cwd | length) | max) as $deepest
		| map(select((.cwd | length) == $deepest))
		| map({pane_id, workspace_id, name, cwd} | with_entries(select(.value != null)))' <<<"$herdr_out")"
	case "$(jq 'length' <<<"$matches")" in
	0) unresolved "no Codex agent in Herdr runs in $cwd or a directory above it" ;;
	1) ;;
	*) unresolved "several Codex agents run in $(jq -r '.[0].cwd' <<<"$matches"), so this one cannot be told apart" "$matches" ;;
	esac
	pane="$(jq -r '.[0].pane_id // empty' <<<"$matches")"
	ws="$(jq -r '.[0].workspace_id // empty' <<<"$matches")"
	[ -n "$ws" ] || unresolved "Herdr lists Codex agent $pane without a workspace"
elif [ -n "$live_pane" ] && [ -n "$ws" ]; then
	pane="$live_pane"
else
	unresolved "Herdr has no pane $HERDR_PANE_ID"
fi

source_id="signal-user:$pane"

tokens() { # tokens: the workspace's metadata tokens, into $tokens_json
	herdr_q workspace get "$ws" || return 1
	tokens_json="$(jq -c '.result.workspace.tokens // {}' <<<"$herdr_out")"
}

clear_signal() {
	herdr_q workspace report-metadata "$ws" --source "$source_id" \
		--clear-token signal --clear-token signal_pane --clear-token signal_skip
}

tokens || herdr_failed "workspace get"
current="$tokens_json"
owner="$(jq -r '.signal_pane // empty' <<<"$current")"
showing="$(jq -r '.signal // empty' <<<"$current")"

if [ "$cmd" = clear ]; then
	# Leave another agent's signal alone; it is still waiting.
	if [ -n "$owner" ] && [ "$owner" != "$pane" ]; then
		report "$(jq -nc --arg ws "$ws" --arg o "$owner" '{status: "not_owner", workspace_id: $ws, owner: $o}')"
		exit 0
	fi
	clear_signal || herdr_failed "workspace report-metadata"
	report "$(jq -nc --arg ws "$ws" '{status: "cleared", workspace_id: $ws}')"
	exit 0
fi

case "$cmd" in
ask) glyph="$ASK" ;;
ready) glyph="$READY" ;;
wait) glyph="$WAIT" ;;
esac
value="$glyph${reason:+ $reason}"

raised=0
urgency() { # urgency <signal text>: higher asks more of the user
	case "$1" in
	"$ASK"*) echo 3 ;;
	"$READY"*) echo 2 ;;
	"$WAIT"*) echo 1 ;;
	*) echo 0 ;;
	esac
}

if [ -n "$owner" ] && [ "$owner" != "$pane" ] && [ "$(urgency "$showing")" -gt "$(urgency "$value")" ]; then
	report "$(jq -nc --arg ws "$ws" --arg s "$showing" '{status: "kept", workspace_id: $ws, signal: $s}')"
else
	herdr_q workspace report-metadata "$ws" --source "$source_id" \
		--token "signal=$value" --token "signal_pane=$pane" \
		--clear-token signal_skip --ttl-ms "$TTL_MS" || herdr_failed "workspace report-metadata"
	raised=1
	report "$(jq -nc --arg ws "$ws" --arg v "$value" '{status: "raised", workspace_id: $ws, signal: $v}')"
fi

[ ${#command[@]} -gt 0 ] || exit 0

# Clear the `…` when the command ends, but only if it is still the one showing:
# any signal raised since then has replaced it and is not ours to end.
#
# If that replacement is this agent's own 🛑 or ✓, the command ending is about
# to wake the agent (its harness reports the finished background job), and the
# plugin would read that resume as the user's reply and clear the signal. So
# leave a `signal_skip` note telling the plugin to let this pane's next resume
# pass. Only when the agent is idle, because an agent already working gets no
# wakeup and the note would instead swallow the user's real reply; and with a
# one-minute TTL, so a wakeup that never comes can't hide a later reply either.
SKIP_TTL_MS=60000
finish() {
	[ "$raised" = 1 ] || return 0
	raised=0
	local now showing_now
	tokens || return 0
	now="$tokens_json"
	[ "$(jq -r '.signal_pane // empty' <<<"$now")" = "$pane" ] || return 0
	showing_now="$(jq -r '.signal // empty' <<<"$now")"
	if [ "$showing_now" = "$value" ]; then
		clear_signal || true
	elif [[ "$showing_now" == "$ASK"* || "$showing_now" == "$READY"* ]]; then
		local status
		status="$("$HERDR" agent get "$pane" 2>/dev/null | jq -r '.result.agent.agent_status // empty')" || return 0
		if [ -n "$status" ] && [ "$status" != working ]; then
			"$HERDR" workspace report-metadata "$ws" --source "$source_id" \
				--token "signal_skip=$pane" --ttl-ms "$SKIP_TTL_MS" >/dev/null 2>&1 || true
		fi
	fi
}
trap finish EXIT

# Run the command as a child and wait on it, so a signal sent to this script
# interrupts the wait, reaches the command, and still runs `finish`. Stdin is
# passed through explicitly, since a background child would otherwise get
# /dev/null.
"${command[@]}" <&0 &
child=$!
trap 'kill -TERM "$child" 2>/dev/null; exit 143' TERM
trap 'kill -INT "$child" 2>/dev/null; exit 130' INT
trap 'kill -HUP "$child" 2>/dev/null; exit 129' HUP
rc=0
wait "$child" || rc=$?
exit "$rc"
