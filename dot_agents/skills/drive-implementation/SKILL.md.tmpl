      "status": "merged",
      "branch": "nxc-702-load-practices",
      "worktree": null,
      "agent": null,
      "pr": 410,
      "review": "passed",
      "notes": "merged 2026-10-01; worktree removed"
    },
    {
      "id": "NXC-703",
      "title": "Load messages",
