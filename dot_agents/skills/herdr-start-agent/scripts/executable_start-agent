#!/usr/bin/env python3
"""Start a coding agent in an existing shell pane, and optionally hand it a first prompt.

The deterministic middle of "put an agent to work here": start the agent in a
pane something else already made (a `herdr-worktree` worktree, a `pane split`,
a tab), map a short model hint to that agent's own CLI flag, and, if a prompt
was given, submit it once with a submission check.

It does not create layout. `agent start` needs an available shell pane, so the
caller supplies `--pane`; deciding where that pane lives is the caller's job.

Two things are worth not re-deriving, and both live here:

  - Model flags differ per agent kind. Most CLIs take `--model <hint>`; a few
    take `-m`. The MODEL_FLAGS table is the one place that knows the exceptions.
  - The first prompt after `agent start` is the one that gets swallowed. A
    stall on it almost always means the keystrokes did not land rather than that
    the agent is thinking, so it is resubmitted once.

Standard library only. If a herdr command changes shape, this fails loudly with
herdr's own stderr rather than guessing.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time

# The prompt goes in fire-and-forget: return as soon as the agent reacts, not
# when the turn finishes, while still getting Herdr's submission check. The
# idle/done entries cover a turn that settles before Herdr samples working.
PROMPT_FLAGS = [
    "--wait",
    "--until", "working",
    "--until", "idle",
    "--until", "done",
    "--timeout", "15000",
]

# Turn a short model hint (e.g. "opus") into the CLI args for a given agent
# kind. Most agent CLIs accept `--model <hint>`, which is the default. Add an
# entry only where a kind needs a different flag or value.
MODEL_FLAGS: dict[str, "callable"] = {
    "gemini": lambda h: ["-m", h],  # gemini also accepts --model
    "codex": lambda h: ["-m", h],   # codex also accepts --model
}


def model_args_for(kind: str, hint: str | None) -> list[str]:
    if not hint:
        return []
    return MODEL_FLAGS.get(kind, lambda h: ["--model", h])(hint)


def die(message: str) -> "None":
    print(f"start-agent: {message}", file=sys.stderr)
    raise SystemExit(1)


def note(message: str) -> None:
    print(f"start-agent: {message}", file=sys.stderr)


def run(args: list[str], cwd: str | None = None) -> subprocess.CompletedProcess[str]:
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True)


def herdr(args: list[str], *, allow_error: bool = False) -> dict:
    """A result comes back as JSON on stdout. A server error comes back as JSON
    on stderr with exit status 1, so read whichever stream has content."""
    done = run(["herdr", *args])
    raw = done.stdout.strip() or done.stderr.strip()
    try:
        payload = json.loads(raw)
    except json.JSONDecodeError:
        die(f"herdr {' '.join(args[:2])} returned no JSON:\n{raw or '(no output)'}")
    if "error" in payload and not allow_error:
        code = payload["error"].get("code", "unknown")
        die(f"herdr {' '.join(args[:2])} failed [{code}]: {payload['error'].get('message', '')}")
    return payload


def valid_name(name: str) -> bool:
    return bool(re.fullmatch(r"[a-z][a-z0-9_-]{0,31}", name))


def free_agent_name(base: str) -> str:
    """First unused name in base, base-2, base-3, ..."""
    for suffix in ["", *(f"-{n}" for n in range(2, 10))]:
        name = f"{base}{suffix}"
        payload = herdr(["agent", "get", name], allow_error=True)
        if payload.get("error", {}).get("code") == "agent_not_found":
            return name
    die(f"no free agent name near {base}; release a finished agent first")


def wait_for_shell(pane: str, timeout_ms: int = 20_000) -> bool:
    """Poll until a pane is back at its own shell prompt.

    `agent start` refuses a pane that is not an available shell, and a pane
    created a moment ago is often still running shell startup. That race is
    intermittent, so waiting for it beats retrying after the failure."""
    deadline = time.monotonic() + timeout_ms / 1000
    while True:
        payload = herdr(["pane", "process-info", "--pane", pane], allow_error=True)
        info = payload.get("result", {}).get("process_info", {})
        shell = info.get("shell_pid")
        foreground = info.get("foreground_processes", [])
        if shell is not None and len(foreground) == 1 and foreground[0].get("pid") == shell:
            return True
        if time.monotonic() >= deadline:
            return False
        time.sleep(0.5)


def read_prompt(args: argparse.Namespace) -> str | None:
    if args.prompt is not None:
        return args.prompt
    if args.prompt_file is not None:
        try:
            with open(args.prompt_file) as handle:
                return handle.read().strip()
        except OSError as exc:
            die(f"cannot read prompt file {args.prompt_file}: {exc}")
    return None


def submit(name: str, text: str) -> dict:
    """Submit the first prompt and confirm it landed, resubmitting once on a
    stall, which almost always means the keystrokes were swallowed."""
    args = ["agent", "prompt", name, text, *PROMPT_FLAGS]
    result = herdr(args, allow_error=True)
    if result.get("error", {}).get("code") == "agent_prompt_stalled":
        note("first submission was not observed; resubmitting once")
        result = herdr(args, allow_error=True)
    return result


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="start-agent",
        description="Start a coding agent in an existing shell pane, optionally with a first prompt.",
    )
    parser.add_argument("name", nargs="?", help="agent name (default: derived from the kind)")
    parser.add_argument("--pane", required=True, help="pane ID to start the agent in")
    parser.add_argument("--kind", required=True, help="agent kind (see `herdr agent` for the installed list)")
    parser.add_argument("--model", help="model name/variant, e.g. opus; mapped to the kind's CLI flag")
    parser.add_argument("--prompt", help="a first prompt to submit once the agent is up")
    parser.add_argument("--prompt-file", help="read the first prompt from this file")
    parser.add_argument("--no-wait-shell", action="store_true",
                        help="do not wait for the pane to reach a shell prompt first")
    args = parser.parse_args()

    if os.environ.get("HERDR_ENV") != "1":
        die("not running inside Herdr (HERDR_ENV is not 1)")

    if args.prompt is not None and args.prompt_file is not None:
        die("pass --prompt or --prompt-file, not both")

    name = args.name or free_agent_name(args.kind)
    if not valid_name(name):
        die(f"invalid agent name {name!r}; must match [a-z][a-z0-9_-]{{0,31}}")

    prompt = read_prompt(args)

    # A freshly created worktree or split pane is often still running shell
    # startup, and `agent start` refuses a pane that is not an available shell.
    if not args.no_wait_shell and not wait_for_shell(args.pane):
        note(f"pane {args.pane} was slow to reach a shell prompt; trying agent start anyway")

    start = ["herdr", "agent", "start", name, "--kind", args.kind, "--pane", args.pane]
    model_args = model_args_for(args.kind, args.model)
    if model_args:
        start += ["--", *model_args]
    started = run(start)
    if started.returncode != 0:
        die(f"could not start {args.kind} in {args.pane}:\n{started.stderr.strip()}")

    prompted = False
    if prompt:
        result = submit(name, prompt)
        if "error" in result:
            code = result["error"].get("code", "unknown")
            die(
                f"agent {name} started in {args.pane}, but the prompt was not submitted [{code}].\n"
                f"         Read it with: herdr agent read {name}"
            )
        prompted = True

    note(f"started {args.kind} as {name} in {args.pane}"
         f"{' and prompted it' if prompted else ''}")
    print(json.dumps({
        "name": name,
        "kind": args.kind,
        "pane_id": args.pane,
        "model": args.model,
        "prompted": prompted,
    }))


if __name__ == "__main__":
    main()
